@@ -25,6 +25,32 @@
 
 namespace hermes {
 
+#if defined(__wasm__) && !defined(__EMSCRIPTEN_THREADS__)
+// Spike: WASI and single-threaded Emscripten cannot create finalizer threads.
+class SerialExecutor {
+  std::deque<llvh::unique_function<void()>> tasks_;
+  bool draining_ = false;
+
+ public:
+  static constexpr std::chrono::nanoseconds kDefaultTimeout =
+      std::chrono::hours(24);
+  SerialExecutor(size_t = 0,
+      std::chrono::nanoseconds = kDefaultTimeout,
+      std::function<void(std::function<void()>)> = {}) {}
+
+  void add(llvh::unique_function<void()> task) {
+    tasks_.push_back(std::move(task));
+    if (draining_) return;
+    draining_ = true;
+    while (!tasks_.empty()) {
+      auto next = std::move(tasks_.front());
+      tasks_.pop_front();
+      next();
+    }
+    draining_ = false;
+  }
+};
+#else
 /// Simple executor that guarantees serial execution of tasks.
 class SerialExecutor {
  private:
@@ -134,6 +160,7 @@ class SerialExecutor {
   /// task enqueued from another thread at that point may never run at all.
   void add(llvh::unique_function<void()> task);
 };
+#endif
 } // namespace hermes
 
 #endif // HERMES_SERIALEXECUTOR_SERIALEXECUTOR_H
