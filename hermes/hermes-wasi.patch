+
+// Platform-specific implementations of thread_cpu_time
+
+std::chrono::microseconds thread_cpu_time() {
+  using namespace std::chrono;
+
+  // WASI preview 1 has no per-thread clock. Its process-clock emulation uses
+  // CLOCK_MONOTONIC, which is also the only thread in this build.
+  clock_t ticks = clock();
+  if (ticks == static_cast<clock_t>(-1)) {
+    return microseconds::max();
+  }
+  return microseconds((ticks * 1000000) / CLOCKS_PER_SEC);
+}
