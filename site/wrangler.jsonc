{
  // bun.shaulavo.dev: the sandbox at /, the terminal playground at /playground/.
  // Only WASM requests (Bun guests, shell, env and base programs) enter the encoding adapter; other assets keep native routing.
  // Waffle's network.wasm ships raw without twins, so it stays on native routing.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bun-wasm",
  "compatibility_date": "2026-10-15",
  "main": "worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/*.wasm", "!/network.wasm", "!/*/network.wasm"]
  },
  "routes": [{ "pattern": "bun.shaulavo.dev", "custom_domain": true }]
}
