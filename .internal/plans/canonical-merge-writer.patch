+async function mergeTables(): Promise<void> {
+  const paths = process.argv.slice(2).map(path => resolve(path));
+  if (paths.length < 1) throw new Error("Usage: bun merge-tables.ts BASE_TABLE.json [RUN_TABLE.json ...]");
+  const base = await load(paths[0]);
+  const accepted: Input[] = [];
+  const skipped: { path: string; reason: string }[] = [];
+  const identities = new Set(base.report.cells.map(key));
+  if (identities.size !== base.report.cells.length) throw new Error("Duplicate base cell");
+  for (const path of Array.from(new Set(paths.slice(1)))) {
+    try {
+      const input = await load(path);
+      const ids = input.report.cells.map(key);
+      if (new Set(ids).size !== ids.length || ids.some(id => !identities.has(id))) throw new Error("unknown or duplicate cell identity");
+      accepted.push(input);
+    } catch (error) { skipped.push({ path, reason: error instanceof Error ? error.message : String(error) }); }
+  }
+  accepted.sort((a, b) => a.time - b.time || a.path.localeCompare(b.path));
+  const cells = new Map<string, Cell>();
+  addReport(cells, base, true);
+  for (const input of accepted) addReport(cells, input, false);
+  const command = ["bun", "/work/reports/goals/merge-tables.ts"].concat(paths).map(shellQuote).join(" ");
+  const campaignPolicy: unknown = JSON.parse(await readFile("/work/reports/goals/CAMPAIGN-POLICY.json", "utf8"));
+  if (!object(campaignPolicy) || campaignPolicy.schema !== 1 || !Array.isArray(campaignPolicy.ownerDecisions)) throw new Error("Invalid campaign policy metadata");
+  const combined: Report = { ...base.report, campaignPolicy, run: crypto.randomUUID(), createdAt: new Date().toISOString(), command, cells: Array.from(cells.values()) };
+  const template = await readFile(join(dirname(paths[0]), "TABLE.md"), "utf8");
+  const root = "/work/reports/goals";
+  const json = JSON.stringify(combined, null, 2) + "\n";
+  await writeFile(join(root, "TABLE.json"), json);
+  await writeFile(join(root, "VIEW.json"), json);
+  await writeFile(join(root, "TABLE.md"), render(combined, command, template));
+  console.log(JSON.stringify({ before: counts(base.report.cells), after: counts(combined.cells), included: accepted.map(input => input.path), skipped }, null, 2));
 }
