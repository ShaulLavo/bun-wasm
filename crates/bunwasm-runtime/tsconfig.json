{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "strict": true,
    "erasableSyntaxOnly": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true
  },
  "include": ["src/js/**/*"]
}
