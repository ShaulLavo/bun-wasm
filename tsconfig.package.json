{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable",
      "WebWorker"
    ],
    "types": [
      "bun"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true
  },
  "include": [
    "src/index.ts",
    "src/assets.ts",
    "src/bun-adapter.ts",
    "build.ts",
    "prepare.ts",
    "tests/package/**/*.ts",
    "src/worker-entry.ts"
  ]
}
