{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable",
      "WebWorker"
    ],
    "types": [
      "bun"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "paths": {
      "waffle": [
        "./node_modules/waffle/index.ts"
      ],
      "waffle/*": [
        "./node_modules/waffle/*"
      ]
    }
  },
  "include": [
    "web/src/index.ts",
    "web/src/assets.ts",
    "web/src/bun-adapter.ts",
    "build.ts",
    "prepare.ts",
    "tests/package/**/*.ts",
    "web/src/worker-entry.ts"
  ]
}
