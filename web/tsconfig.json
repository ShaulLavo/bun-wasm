{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "types": ["bun"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true
  },
  "include": ["src", "scripts", "build.ts", "serve.ts", "tests/browser-process.ts", "tests/process-browser-main.ts", "tests/process-fixtures.ts", "tests/process-fixtures.test.ts", "tests/process-benchmark.ts", "tests/foreground.ts", "tests/foreground.test.ts"]
}
