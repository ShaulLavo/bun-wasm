;; Globals in the regionized declaration order. Assemble with `wasm-tools parse`.
(module
  (import "env" "seed" (global $seed i32))
  (import "bunwasm_region" "base" (global i32))
  (import "bunwasm_region" "bound0" (global i64))
  (import "bunwasm_region" "memory" (memory 1 512 shared))
  (import "env" "observe" (func $observe (result i32)))
  (global $answer i32 (i32.const 42))
  (global $counter (mut i32) (i32.const 7))
  (global $wide (mut i64) (i64.const 9))
  (global $single (mut f32) (f32.const 1.5))
  (global $double (mut f64) (f64.const 1.5))
  (global $fromSeed i32 (global.get $seed))
  (global $vector (mut v128) (v128.const i32x4 0 0 0 0))
  (global $afterVector i32 (i32.const 11))
  (global funcref (ref.null func))
  (global $started (mut i32) (i32.const 0))
  (table 1 funcref)
  (func $start
    call $observe global.set $started
    global.get $started i32.const -1 i32.eq
    if unreachable end)
  (start $start)
  (func (export "getCounter") (result i32) global.get $counter)
  (func (export "setCounter") (param i32) local.get 0 global.set $counter)
  (func (export "getWide") (result i64) global.get $wide)
  (func (export "observeThenCounter") (result i32) call $observe drop global.get $counter)
  (export "memory" (memory 0))
  (export "table" (table 0))
  (export "seed" (global $seed))
  (export "answer" (global $answer))
  (export "counter" (global $counter))
  (export "counterAlias" (global $counter))
  (export "wide" (global $wide))
  (export "single" (global $single))
  (export "double" (global $double))
  (export "fromSeed" (global $fromSeed))
  (export "vector" (global $vector))
  (export "afterVector" (global $afterVector))
  (export "started" (global $started)))
