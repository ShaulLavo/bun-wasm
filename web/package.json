    "test:browser:child-ipc": "bun tests/browser-child-process-ipc.ts",
    "test:browser:bun-runtime-proc": "bun tests/bun-runtime-proc-browser.ts",
    "test:browser:safari:build": "bun tests/browser-safari.ts --build",
    "test:browser:safari": "bun tests/browser-safari.ts --run",
    "test:browser:safari:shell": "bun tests/safari-shell.ts",
    "test:browser:engine-interruption": "bun tests/browser-engine-interruption.ts chromium firefox webkit",
    "test:next:native": "bun tests/next-framework-native.ts",
