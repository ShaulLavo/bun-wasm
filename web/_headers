/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Resource-Policy: same-origin

/
  Cache-Control: no-store
/index.html
  Cache-Control: no-store
/sw.js
  Cache-Control: no-store
# Entry bundles and chunks carry a content hash, so a browser may keep 200 responses. Every Bun
# process starts a worker that imports them in a chain; revalidating each one cost a network round
# trip per link. Missing paths fall through to site/worker.ts, which overrides error responses to
# Cache-Control: no-store so 404s are never cached as immutable. Unhashed files (worker.js,
# chunks/network.wasm) keep the default revalidation.
/entry-*
  Cache-Control: public, max-age=31536000, immutable
/__bunwasm/entry-*
  Cache-Control: public, max-age=31536000, immutable
/chunks/*.js
  Cache-Control: public, max-age=31536000, immutable
/__bunwasm/chunks/*.js
  Cache-Control: public, max-age=31536000, immutable
