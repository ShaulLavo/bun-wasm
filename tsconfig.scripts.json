  "include": [
    "scripts/**/*.ts",
    "scripts/**/*.mts",
    "site/*.ts",
    "tests/check-worker-regressions.ts"
  ],
  "compilerOptions": {
    "allowJs": true,
    "lib": [
      "ES2024",
