(module
  (import "env" "memory" (memory 1 2 shared))
  (import "env" "observe" (func $observe))
  (export "memory" (memory 0))
  (export "alias" (memory 0))
  (func (export "read") (result i32) i32.const 0 i32.atomic.load)
  (func (export "write") (param i32) i32.const 0 local.get 0 i32.atomic.store)
  (func (export "add") (param i32) (result i32) i32.const 0 local.get 0 i32.atomic.rmw.add)
  (func (export "grow") (param i32) (result i32) local.get 0 memory.grow)
  (func (export "callback") call $observe)
  (func (export "wait") (param i32 i64) (result i32)
    i32.const 0 local.get 0 local.get 1 memory.atomic.wait32)
  (func (export "notify") (result i32) i32.const 0 i32.const 1 memory.atomic.notify)
  (func (export "misaligned") (result i32) i32.const 1 i32.atomic.load)
  (func (export "oob") (result i32) i32.const 131072 i32.atomic.load)
  (func (export "read64") (result i64) i32.const 8 i64.atomic.load)
  (func (export "write64") (param i64) i32.const 8 local.get 0 i64.atomic.store)
  (func (export "write16") (param i32) i32.const 4 local.get 0 i32.atomic.store16)
  (func (export "read16") (result i32) i32.const 4 i32.atomic.load16_u)
  (func (export "compare") (param i32 i32) (result i32)
    i32.const 0 local.get 0 local.get 1 i32.atomic.rmw.cmpxchg)
  (func (export "overflow") (result i32) i32.const -4 i32.atomic.load offset=8)
  (func (export "fill") (param i32 i32 i32)
    local.get 0 local.get 1 local.get 2 memory.fill)
  (func (export "simd") (result i32)
    i32.const 16 v128.const i32x4 1 2 3 4 v128.store
    i32.const 16 v128.load i32x4.extract_lane 2))
