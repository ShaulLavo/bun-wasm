{
  "type": "module",
  "scripts": {
    "test": "bun test ./sample.test.ts",
    "failed-test": "bun test ./failure.test.ts",
    "evaluate": "node -e \"console.log(42)\"",
    "print": "node -p \"21 * 2\"",
    "ok": "node ./app.ts",
    "bin-script": "tool baked",
    "alias": "MODE=outer bun --smol run inspect first",
    "inspect": "MARK=inner node ./inspect.ts second",
    "exit": "node -e \"process.exit(17)\"",
    "cli-flags": "bun --no-install --smol run -p \"21 * 2\"",
    "node-file": "node test tail",
    "node-alias-file": "node inspect tail",
    "cycle-a": "bun run cycle-b",
    "cycle-b": "bun run cycle-a",
    "implicit-a": "bun implicit-b",
    "implicit-b": "bun implicit-a"
  }
}
