(module
  (import "env" "one" (func $one (result i32)))
  (import "env" "wide" (func $wide (result i64)))
  (import "env" "pair" (func $pair (result i32 f64)))
  (memory (export "first") 1 3)
  (export "second" (memory 0))
  (memory (export "empty") 0 1)
  (memory (export "otherEmpty") 0 1)
  (global (export "counter") (mut i32) (i32.const 4))
  (global (export "fixed") i32 (i32.const 4))
  (global (export "big") (mut i64) (i64.const 4))
  (func (export "load") (result i32) i32.const 0 i32.load8_u)
  (func (export "zero") (result i32) i32.const 0 memory.grow)
  (func (export "grow") (param i32) (result i32) local.get 0 memory.grow)
  (func (export "i32") (param i32) (result i32) local.get 0)
  (func (export "i64") (param i64) (result i64) local.get 0)
  (func (export "f32") (param f32) (result f32) local.get 0)
  (func (export "f64") (param f64) (result f64) local.get 0)
  (func (export "one") (result i32) call $one)
  (func (export "wide") (result i64) call $wide)
  (func (export "pair") (result i32 f64) call $pair)
  (func (export "trap") unreachable))
