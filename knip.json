{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/app-matrix/run.mjs",
        "scripts/app-matrix/engine-memory-hook.ts",
        "scripts/engine-producer.ts",
        "scripts/replay-engine-lineage.ts",
        "scripts/verify-engine-memory-browser.ts",
        "scripts/app-matrix/vinext-probe.ts",
        "scripts/fixtures/vinext-probe-control.ts",
        "scripts/app-matrix/reclassify.mjs",
        "scripts/app-matrix/next-acceptance.ts",
        "scripts/app-matrix/next-acceptance-reference.ts",
        "scripts/app-matrix/*.test.{ts,mjs}",
        "tests/package/*.test.ts",
        "tests/memory-telemetry.test.ts",
        "tests/check-worker-regressions.ts",
        "scripts/app-matrix/isolate.mjs",
        "scripts/bench/error-construction.js",
        "tests/package/fixtures/vite-main.ts",
        "tests/package/fixtures/paired-asset-brand.ts",
        "scripts/**/*.test.ts",
        "scripts/fixtures/crypto-host-native-control.ts",
        "scripts/fixtures/event-rejections-control.ts",
        "scripts/fixtures/quickjs-async-context.ts",
        "scripts/fixtures/runtime-js-child.ts",
        "scripts/migrations/*.ts",
        "scripts/bench-module-preparation.ts",
        "scripts/engine-comparison.ts",
        "scripts/esm-loader-*.ts",
        "scripts/bun-suite-small-causes.ts",
        "scripts/discover-solid-watch-import.ts",
        "scripts/check-await-observer.ts",
        "scripts/check-encoded-slice.ts",
        "scripts/check-quickjs-async-context.ts",
        "scripts/check-quickjs-memory-telemetry.ts",
        "scripts/crypto-review-vectors.mjs",
        "scripts/generate-*.{ts,mjs}",
        "scripts/guest-core-receipt.ts",
        "scripts/guest-engine-receipt.ts",
        "scripts/hermes-import-delta.ts",
        "scripts/measure-suite-dependencies.ts",
        "scripts/refresh-compatibility-docs.ts",
        "scripts/group-suite-category-d.ts",
        "scripts/run-with-timeout.mts",
        "scripts/shared-sysroot-proof.ts",
        "scripts/runtime-size.ts",
        "scripts/test-*.mjs",
        "scripts/transpile-runtime.ts",
        "scripts/vendor-node-streams.mjs",
        "scripts/vendor-intl.ts",
        "scripts/wasm-size-breakdown.ts",
        "scripts/stream-polyfill-node-hooks.ts",
        "scripts/http-suite-report.ts",
        "scripts/ci-report.ts",
        "tests/shell-consumer/{main,worker,fs-worker,sw}.ts"
      ],
      "project": [
        "src/**/*.ts",
        "scripts/**/*.{ts,mts,mjs,js}",
        "tests/package/**/*.ts"
      ],
      "ignoreDependencies": [
        "^bash-web(?:/.*)?$"
      ]
    },
    "web": {
      "entry": [
        "src/main.ts",
        "src/worker.ts",
        "src/net/helper.ts",
        "tests/*.test.{ts,js}",
        "guest-tests/*.test.ts",
        "tests/browser-*.{ts,mjs}",
        "tests/ten-app-finishline.ts",
        "scripts/*.{ts,mjs}",
        "src/fs-worker.ts",
        "src/sw.ts",
        "src/preview-websocket-client.ts",
        "tests/bench-*.{ts,mjs}",
        "tests/compare-memory.mjs",
        "tests/crypto-aes192-gap.mjs",
        "tests/crypto-no-provider.mjs",
        "tests/node-root-signals.ts",
        "tests/engine-interruption-{page,worker}.ts",
        "tests/filesystem-{bench-main,bench-worker,browser-failure,browser-guest,browser-main}.ts",
        "tests/persistence-browser-{main,worker}.ts",
        "tests/process-{bench-baseline,browser-main}.ts",
        "tests/runtime-proc-browser-main.ts",
        "tests/fixtures/{editor-execution,filesystem-lifecycle,safari-driver-listener,startup-filesystem}.ts",
        "tests/bun-runtime-proc-main.ts",
        "tests/wasm-transfer-page.ts",
        "tests/safari-{observers,open-descriptor-worker}.ts",
        "tests/worker-bootstrap-browser.ts",
        "tests/worker-bootstrap-browser-main.ts"
      ],
      "project": [
        "src/**/*.{ts,js}",
        "scripts/**/*.{ts,mjs}",
        "tests/**/*.{ts,mjs,js}",
        "guest-tests/**/*.ts"
      ],
      "ignoreDependencies": [
        "benchmark"
      ],
      "ignoreUnresolved": [
        "../src/subprocess.js"
      ]
    },
    "sandbox": {
      "entry": [
        "src/main.ts",
        "tests/*.{test.ts,mjs,js}"
      ],
      "project": [
        "src/**/*.ts",
        "tests/**/*.{ts,mjs,js}"
      ],
      "ignoreDependencies": [
        "waffle-base"
      ]
    },
    "site": {
      "entry": [],
      "project": [
        "*.ts"
      ]
    }
  },
  "ignoreBinaries": [
    "unshare",
    "rustc",
    "ss",
    "build.mjs",
    "^c\\+\\+$"
  ],
  "ignoreUnresolved": [
    "./space # \u00fc.mjs"
  ]
}
