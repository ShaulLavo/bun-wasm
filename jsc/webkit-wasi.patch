diff --git a/Source/JavaScriptCore/runtime/WASIMemoryTelemetry.h b/Source/JavaScriptCore/runtime/WASIMemoryTelemetry.h
new file mode 100644
--- /dev/null
+++ b/Source/JavaScriptCore/runtime/WASIMemoryTelemetry.h
@@ -0,0 +1,92 @@
+#pragma once
+
+#include <cstdint>
+#include <limits>
+
+constexpr uint64_t bunjscUnknownMemory = std::numeric_limits<uint64_t>::max();
+
+// Every field is a little-endian u64 in the shared wasm memory.
+struct BunjscMemoryTelemetry {
+    uint64_t abiVersion { 1 };
+    uint64_t byteLength { sizeof(BunjscMemoryTelemetry) };
+    uint64_t snapshotSequence { 0 };
+    uint64_t heapUsed { bunjscUnknownMemory };
+    uint64_t heapTotal { bunjscUnknownMemory };
+    uint64_t extraMemory { bunjscUnknownMemory };
+    uint64_t arrayBufferBytes { bunjscUnknownMemory };
+    uint64_t heapAfterLastCollection { bunjscUnknownMemory };
+    uint64_t heapBeforeLastFullCollection { bunjscUnknownMemory };
+    uint64_t heapAfterLastFullCollection { bunjscUnknownMemory };
+    uint64_t totalBytesAllocated { bunjscUnknownMemory };
+    uint64_t gcMaxHeapSize { bunjscUnknownMemory };
+    uint64_t smallHeapSize { bunjscUnknownMemory };
+    uint64_t largeHeapSize { bunjscUnknownMemory };
+    uint64_t gcEnabled { bunjscUnknownMemory };
+    uint64_t generationalGcEnabled { bunjscUnknownMemory };
+    uint64_t concurrentGcEnabled { bunjscUnknownMemory };
+    uint64_t allocationSequence { 0 };
+    uint64_t activeAllocationBytes { bunjscUnknownMemory };
+    uint64_t activeAllocationCategory { 0 };
+    uint64_t failedAllocationBytes { bunjscUnknownMemory };
+    uint64_t failedAllocationCategory { 0 };
+    uint64_t failedAllocationSequence { 0 };
+    uint64_t allocationBudgetThisCycle { bunjscUnknownMemory };
+};
+
+inline constinit BunjscMemoryTelemetry bunjscTelemetry;
+inline constinit uint32_t bunjscAllocationDepth { 0 };
+
+inline BunjscMemoryTelemetry* bunjsc_cached_memory_telemetry()
+{
+    return &bunjscTelemetry;
+}
+
+extern "C" inline void bunjsc_telemetry_allocation_begin(uint64_t bytes, uint32_t category)
+{
+    if (bunjscAllocationDepth++)
+        return;
+    ++bunjscTelemetry.allocationSequence;
+    bunjscTelemetry.activeAllocationBytes = bytes;
+    bunjscTelemetry.activeAllocationCategory = category;
+}
+
+extern "C" inline void bunjsc_telemetry_allocation_end(bool failed)
+{
+    if (failed && bunjscTelemetry.failedAllocationSequence != bunjscTelemetry.allocationSequence) {
+        bunjscTelemetry.failedAllocationBytes = bunjscTelemetry.activeAllocationBytes;
+        bunjscTelemetry.failedAllocationCategory = bunjscTelemetry.activeAllocationCategory;
+        bunjscTelemetry.failedAllocationSequence = bunjscTelemetry.allocationSequence;
+    }
+    if (--bunjscAllocationDepth)
+        return;
+    bunjscTelemetry.activeAllocationBytes = bunjscUnknownMemory;
+    bunjscTelemetry.activeAllocationCategory = 0;
+}
+
+namespace JSC {
+
+// The destructor runs before the caller constructs its OOM exception.
+class WASIMemoryAllocationScope {
+public:
+    enum Category : uint32_t { TypedArray = 1, ArrayBuffer = 2 };
+
+    WASIMemoryAllocationScope(uint64_t bytes, Category category)
+    {
+        bunjsc_telemetry_allocation_begin(bytes, category);
+    }
+
+    WASIMemoryAllocationScope(const WASIMemoryAllocationScope&) = delete;
+    WASIMemoryAllocationScope& operator=(const WASIMemoryAllocationScope&) = delete;
+
+    ~WASIMemoryAllocationScope()
+    {
+        bunjsc_telemetry_allocation_end(m_failed);
+    }
+
+    void succeed() { m_failed = false; }
+
+private:
+    bool m_failed { true };
+};
+
+} // namespace JSC
