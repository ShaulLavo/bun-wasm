--- /dev/null
+++ b/Source/JavaScriptCore/runtime/WASIMemoryTelemetry.h
@@ -0,0 +1,376 @@
+#pragma once
+
+#include <cerrno>
+#include <cstddef>
+#include <cstdint>
+#include <limits>
+
+constexpr uint64_t bunjscUnknownMemory = std::numeric_limits<uint64_t>::max();
+
+// Every field is a little-endian u64 in the shared wasm memory.
+struct BunjscMemoryTelemetry {
+    uint64_t abiVersion { 1 };
+    uint64_t byteLength { sizeof(BunjscMemoryTelemetry) };
+    uint64_t snapshotSequence { 0 };
+    uint64_t heapUsed { bunjscUnknownMemory };
+    uint64_t heapTotal { bunjscUnknownMemory };
+    uint64_t extraMemory { bunjscUnknownMemory };
+    uint64_t arrayBufferBytes { bunjscUnknownMemory };
+    uint64_t heapAfterLastCollection { bunjscUnknownMemory };
+    uint64_t heapBeforeLastFullCollection { bunjscUnknownMemory };
+    uint64_t heapAfterLastFullCollection { bunjscUnknownMemory };
+    uint64_t totalBytesAllocated { bunjscUnknownMemory };
+    uint64_t gcMaxHeapSize { bunjscUnknownMemory };
+    uint64_t smallHeapSize { bunjscUnknownMemory };
+    uint64_t largeHeapSize { bunjscUnknownMemory };
+    uint64_t gcEnabled { bunjscUnknownMemory };
+    uint64_t generationalGcEnabled { bunjscUnknownMemory };
+    uint64_t concurrentGcEnabled { bunjscUnknownMemory };
+    uint64_t allocationSequence { 0 };
+    uint64_t activeAllocationBytes { bunjscUnknownMemory };
+    uint64_t activeAllocationCategory { 0 };
+    uint64_t failedAllocationBytes { bunjscUnknownMemory };
+    uint64_t failedAllocationCategory { 0 };
+    uint64_t failedAllocationSequence { 0 };
+    uint64_t allocationBudgetThisCycle { bunjscUnknownMemory };
+};
+
+inline constinit BunjscMemoryTelemetry bunjscTelemetry;
+inline constinit uint32_t bunjscAllocationDepth { 0 };
+
+inline BunjscMemoryTelemetry* bunjsc_cached_memory_telemetry()
+{
+    return &bunjscTelemetry;
+}
+
+extern "C" inline void bunjsc_telemetry_allocation_begin(uint64_t bytes, uint32_t category)
+{
+    if (bunjscAllocationDepth++)
+        return;
+    ++bunjscTelemetry.allocationSequence;
+    bunjscTelemetry.activeAllocationBytes = bytes;
+    bunjscTelemetry.activeAllocationCategory = category;
+}
+
+inline void bunjsc_telemetry_allocation_failed()
+{
+    if (bunjscTelemetry.failedAllocationSequence != bunjscTelemetry.allocationSequence) {
+        bunjscTelemetry.failedAllocationBytes = bunjscTelemetry.activeAllocationBytes;
+        bunjscTelemetry.failedAllocationCategory = bunjscTelemetry.activeAllocationCategory;
+        bunjscTelemetry.failedAllocationSequence = bunjscTelemetry.allocationSequence;
+    }
+}
+
+extern "C" inline void bunjsc_telemetry_allocation_end(bool failed)
+{
+    if (failed)
+        bunjsc_telemetry_allocation_failed();
+    if (--bunjscAllocationDepth)
+        return;
+    bunjscTelemetry.activeAllocationBytes = bunjscUnknownMemory;
+    bunjscTelemetry.activeAllocationCategory = 0;
+}
+
+// Allocation-boundary diagnostic around the two oversize typed-array Gigacage calls in
+// JSArrayBufferView::ConstructionContext. Inert until the embedder arms it for one VM. It allocates
+// nothing, takes no lock, never writes errno, never collects and changes no allocation policy.
+// Every field is a little-endian u64; the record is cached and readable after a failure or trap.
+
+// Above JSArrayBufferView::fastSizeLimit (1000 elements), so the control takes the oversize branch.
+constexpr uint64_t bunjscBoundaryControlLength = 1001;
+// A host-chosen per-instance generation the VM acknowledges in its record. At most 2^53 - 1 so a
+// JavaScript host reads it exactly; zero and larger values mean no generation was supplied.
+constexpr uint64_t bunjscBoundaryGenerationLimit = (uint64_t(1) << 53) - 1;
+
+enum class BunjscBoundaryState : uint64_t { Disarmed, ControlArmed, SubjectArmed, Rejected };
+enum class BunjscBoundaryRejection : uint64_t {
+    None,
+    ControlNotObserved,
+    ControlAttempts,
+    CoverageMiss,
+    ControlFailed,
+    ControlRequest,
+    ControlIdentity,
+    CoreUnavailable,
+    CoreFailureCount,
+    CoreAllocationCount,
+    GenerationAbsent,
+    ControlGeneration,
+};
+
+// Raw values from the core's bun_memory_telemetry (live, peak, capacity, failures, allocations,
+// frees) and bun_memory_failure_telemetry (first failed size and category), including the
+// core's own UINT64_MAX and zero-category "none" values.
+struct BunjscCoreAllocatorSample {
+    uint64_t live { bunjscUnknownMemory };
+    uint64_t peak { bunjscUnknownMemory };
+    uint64_t capacity { bunjscUnknownMemory };
+    uint64_t failures { bunjscUnknownMemory };
+    uint64_t allocations { bunjscUnknownMemory };
+    uint64_t frees { bunjscUnknownMemory };
+    uint64_t firstFailureSize { bunjscUnknownMemory };
+    uint64_t firstFailureCategory { bunjscUnknownMemory };
+};
+// Bound by the side's helpers.cpp to the two core exports. False means the core record is unreadable.
+using BunjscCoreAllocatorSampler = bool (*)(BunjscCoreAllocatorSample&);
+
+// JSC heap pacing values before the call. Plain getters; mutator thread only.
+struct BunjscBoundaryHeapBudget {
+    uint64_t capacity { bunjscUnknownMemory };
+    uint64_t extraMemory { bunjscUnknownMemory };
+    uint64_t arrayBufferBytes { bunjscUnknownMemory };
+    uint64_t totalBytesAllocated { bunjscUnknownMemory };
+    uint64_t bytesAllocatedThisCycle { bunjscUnknownMemory };
+    uint64_t allocationBudgetThisCycle { bunjscUnknownMemory };
+    uint64_t maxHeapSize { bunjscUnknownMemory };
+    uint64_t sizeAfterLastCollection { bunjscUnknownMemory };
+    uint64_t ramSize { bunjscUnknownMemory };
+};
+
+struct BunjscAllocationBoundarySlot {
+    uint64_t recorded { 0 };
+    uint64_t availability { 0 }; // Bit i set: word i of this slot holds an observed value.
+    uint64_t attempt { 0 }; // Ordinal among armed attempts in the expected VM.
+    uint64_t requestSequence { bunjscUnknownMemory }; // bunjscTelemetry.allocationSequence
+    uint64_t requestBytes { bunjscUnknownMemory };
+    uint64_t elementCount { bunjscUnknownMemory };
+    uint64_t elementSize { bunjscUnknownMemory };
+    uint64_t zeroFill { bunjscUnknownMemory };
+    uint64_t vmAddress { bunjscUnknownMemory };
+    uint64_t globalObjectAddress { bunjscUnknownMemory };
+    uint64_t errnoBefore { bunjscUnknownMemory }; // Raw; read before any observer work.
+    uint64_t errnoAfterCall { bunjscUnknownMemory }; // Raw; read first after the call returns.
+    uint64_t resultNull { bunjscUnknownMemory };
+    BunjscBoundaryHeapBudget heapBefore;
+    BunjscCoreAllocatorSample coreBefore;
+    BunjscCoreAllocatorSample coreAfter;
+    uint64_t generation { bunjscUnknownMemory }; // The record's generation when this slot was written.
+};
+static_assert(sizeof(BunjscAllocationBoundarySlot) == 39 * sizeof(uint64_t));
+
+constexpr uint64_t bunjscBoundaryWords(size_t offset, size_t bytes)
+{
+    uint64_t mask = 0;
+    for (size_t word = offset / sizeof(uint64_t); word < (offset + bytes) / sizeof(uint64_t); ++word)
+        mask |= uint64_t(1) << word;
+    return mask;
+}
+constexpr uint64_t bunjscBoundaryBeforeWords = bunjscBoundaryWords(0, offsetof(BunjscAllocationBoundarySlot, errnoAfterCall));
+constexpr uint64_t bunjscBoundaryAfterCallWords = bunjscBoundaryWords(offsetof(BunjscAllocationBoundarySlot, errnoAfterCall), 2 * sizeof(uint64_t));
+constexpr uint64_t bunjscBoundaryHeapWords = bunjscBoundaryWords(offsetof(BunjscAllocationBoundarySlot, heapBefore), sizeof(BunjscBoundaryHeapBudget));
+constexpr uint64_t bunjscBoundarySizeAfterLastCollectionWord = bunjscBoundaryWords(offsetof(BunjscAllocationBoundarySlot, heapBefore) + offsetof(BunjscBoundaryHeapBudget, sizeAfterLastCollection), sizeof(uint64_t));
+constexpr uint64_t bunjscBoundaryCoreBeforeWords = bunjscBoundaryWords(offsetof(BunjscAllocationBoundarySlot, coreBefore), sizeof(BunjscCoreAllocatorSample));
+constexpr uint64_t bunjscBoundaryCoreAfterWords = bunjscBoundaryWords(offsetof(BunjscAllocationBoundarySlot, coreAfter), sizeof(BunjscCoreAllocatorSample));
+constexpr uint64_t bunjscBoundaryGenerationWord = bunjscBoundaryWords(offsetof(BunjscAllocationBoundarySlot, generation), sizeof(uint64_t));
+
+struct BunjscAllocationBoundary {
+    uint64_t abiVersion { 1 };
+    uint64_t byteLength { sizeof(BunjscAllocationBoundary) };
+    BunjscBoundaryState state { BunjscBoundaryState::Disarmed };
+    BunjscBoundaryRejection rejection { BunjscBoundaryRejection::None };
+    uint64_t coreSamplerBound { 0 };
+    uint64_t expectedVmAddress { bunjscUnknownMemory };
+    uint64_t expectedGlobalObjectAddress { bunjscUnknownMemory };
+    uint64_t controlLength { bunjscBoundaryControlLength };
+    uint64_t armedAttempts { 0 };
+    uint64_t subjectFailures { 0 };
+    uint64_t coverageMisses { 0 }; // Oversize calls in another VM while armed; never recorded.
+    uint64_t generation { bunjscUnknownMemory }; // Set once when the control is armed.
+    BunjscAllocationBoundarySlot last; // The latest armed attempt, written before its call.
+    BunjscAllocationBoundarySlot control;
+    BunjscAllocationBoundarySlot subject; // The first null result after the subject was armed.
+};
+static_assert(sizeof(BunjscAllocationBoundary) == 1032);
+
+inline constinit BunjscAllocationBoundary bunjscAllocationBoundary;
+inline constinit BunjscCoreAllocatorSampler bunjscCoreAllocatorSampler { nullptr };
+
+inline bool bunjsc_boundary_armed()
+{
+    auto state = bunjscAllocationBoundary.state;
+    return state == BunjscBoundaryState::ControlArmed || state == BunjscBoundaryState::SubjectArmed;
+}
+
+inline uint64_t bunjsc_boundary_sample_core(BunjscCoreAllocatorSample& sample, uint64_t words)
+{
+    if (!bunjscCoreAllocatorSampler || !bunjscCoreAllocatorSampler(sample))
+        return 0;
+    return words;
+}
+
+template<typename HeapType>
+inline uint64_t bunjsc_boundary_read_heap(HeapType& heap, BunjscBoundaryHeapBudget& budget)
+{
+    budget.capacity = heap.capacity();
+    budget.extraMemory = heap.extraMemorySize();
+    budget.arrayBufferBytes = heap.arrayBufferSize();
+    budget.totalBytesAllocated = heap.totalBytesAllocated();
+    budget.bytesAllocatedThisCycle = heap.bytesAllocatedThisCycle();
+    budget.allocationBudgetThisCycle = heap.allocationBudgetThisCycle();
+    budget.maxHeapSize = heap.maxHeapSize();
+    budget.ramSize = heap.ramSize();
+    if (!heap.lastCollectionScope())
+        return bunjscBoundaryHeapWords & ~bunjscBoundarySizeAfterLastCollectionWord;
+    budget.sizeAfterLastCollection = heap.sizeAfterLastCollection();
+    return bunjscBoundaryHeapWords;
+}
+
+// The control acknowledges only one exact, successful ZeroFill request in the armed VM and
+// context whose core wrapper counted one allocation and no new failure.
+inline BunjscBoundaryRejection bunjsc_boundary_control_rejection(const BunjscAllocationBoundary& record, bool created)
+{
+    const auto& control = record.control;
+    if (!control.recorded)
+        return BunjscBoundaryRejection::ControlNotObserved;
+    if (record.coverageMisses)
+        return BunjscBoundaryRejection::CoverageMiss;
+    if (record.armedAttempts != 1)
+        return BunjscBoundaryRejection::ControlAttempts;
+    if (!created || control.resultNull)
+        return BunjscBoundaryRejection::ControlFailed;
+    if (control.elementCount != record.controlLength || control.elementSize != 1 || control.requestBytes != record.controlLength || control.zeroFill != 1)
+        return BunjscBoundaryRejection::ControlRequest;
+    if (control.vmAddress != record.expectedVmAddress || control.globalObjectAddress != record.expectedGlobalObjectAddress)
+        return BunjscBoundaryRejection::ControlIdentity;
+    if (control.generation != record.generation)
+        return BunjscBoundaryRejection::ControlGeneration;
+    constexpr uint64_t core = bunjscBoundaryCoreBeforeWords | bunjscBoundaryCoreAfterWords;
+    if ((control.availability & core) != core)
+        return BunjscBoundaryRejection::CoreUnavailable;
+    if (control.coreAfter.failures != control.coreBefore.failures)
+        return BunjscBoundaryRejection::CoreFailureCount;
+    if (control.coreAfter.allocations != control.coreBefore.allocations + 1)
+        return BunjscBoundaryRejection::CoreAllocationCount;
+    return BunjscBoundaryRejection::None;
+}
+
+// Arms the control for one VM, context and generation. Only a disarmed record arms; a missing
+// generation rejects the record for good.
+inline bool bunjsc_boundary_arm_control(const void* vm, const void* globalObject, uint64_t generation, BunjscCoreAllocatorSampler sampler)
+{
+    auto& record = bunjscAllocationBoundary;
+    if (record.state != BunjscBoundaryState::Disarmed)
+        return false;
+    if (!generation || generation > bunjscBoundaryGenerationLimit) {
+        record.state = BunjscBoundaryState::Rejected;
+        record.rejection = BunjscBoundaryRejection::GenerationAbsent;
+        return false;
+    }
+    record.generation = generation;
+    bunjscCoreAllocatorSampler = sampler;
+    record.coreSamplerBound = sampler != nullptr;
+    record.expectedVmAddress = reinterpret_cast<uintptr_t>(vm);
+    record.expectedGlobalObjectAddress = reinterpret_cast<uintptr_t>(globalObject);
+    record.state = BunjscBoundaryState::ControlArmed;
+    return true;
+}
+
+// The only transition to SubjectArmed. A rejected control leaves the subject disarmed for good.
+inline BunjscBoundaryState bunjsc_boundary_acknowledge_control(bool created)
+{
+    auto& record = bunjscAllocationBoundary;
+    if (record.state != BunjscBoundaryState::ControlArmed)
+        return record.state;
+    record.rejection = bunjsc_boundary_control_rejection(record, created);
+    record.state = record.rejection == BunjscBoundaryRejection::None ? BunjscBoundaryState::SubjectArmed : BunjscBoundaryState::Rejected;
+    return record.state;
+}
+
+inline void bunjsc_boundary_latch(BunjscAllocationBoundary& record, const BunjscAllocationBoundarySlot& slot)
+{
+    if (record.state == BunjscBoundaryState::ControlArmed) {
+        if (!record.control.recorded)
+            record.control = slot;
+        return;
+    }
+    if (!slot.resultNull)
+        return;
+    ++record.subjectFailures;
+    if (!record.subject.recorded)
+        record.subject = slot;
+}
+
+namespace JSC {
+
+// Nullable failure can be recorded before an OOM exception that may not unwind.
+class WASIMemoryAllocationScope {
+public:
+    enum Category : uint32_t { TypedArray = 1, ArrayBuffer = 2 };
+    enum class FailurePolicy { ReportFailure, ObserveOnly };
+
+    WASIMemoryAllocationScope(uint64_t bytes, Category category, FailurePolicy policy = FailurePolicy::ReportFailure)
+        : m_failed(policy == FailurePolicy::ReportFailure)
+    {
+        bunjsc_telemetry_allocation_begin(bytes, category);
+    }
+
+    WASIMemoryAllocationScope(const WASIMemoryAllocationScope&) = delete;
+    WASIMemoryAllocationScope& operator=(const WASIMemoryAllocationScope&) = delete;
+
+    ~WASIMemoryAllocationScope()
+    {
+        bunjsc_telemetry_allocation_end(m_failed);
+    }
+
+    void succeed() { m_failed = false; }
+    void fail() { bunjsc_telemetry_allocation_failed(); }
+
+private:
+    bool m_failed;
+};
+
+// Observes one oversize typed-array allocation call. A disarmed record costs one state load.
+class WASIAllocationBoundaryProbe {
+public:
+    template<typename HeapType, typename StructureType>
+    WASIAllocationBoundaryProbe(const void* vm, StructureType* structure, HeapType& heap, uint64_t elementCount, uint64_t elementSize, uint64_t bytes, bool zeroFill)
+    {
+        if (!bunjsc_boundary_armed())
+            return;
+        uint64_t errnoBefore = static_cast<uint32_t>(errno);
+        auto& record = bunjscAllocationBoundary;
+        if (reinterpret_cast<uintptr_t>(vm) != record.expectedVmAddress) {
+            ++record.coverageMisses;
+            return;
+        }
+        m_active = true;
+        auto& slot = record.last;
+        slot = { };
+        slot.recorded = 1;
+        slot.attempt = ++record.armedAttempts;
+        slot.requestSequence = bunjscTelemetry.allocationSequence;
+        slot.requestBytes = bytes;
+        slot.elementCount = elementCount;
+        slot.elementSize = elementSize;
+        slot.zeroFill = zeroFill;
