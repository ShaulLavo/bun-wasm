diff --git a/src/crash_handler/CPUFeatures.rs b/src/crash_handler/CPUFeatures.rs
index 5736ea90..7baae5d0 100644
--- a/src/crash_handler/CPUFeatures.rs
+++ b/src/crash_handler/CPUFeatures.rs
@@ -1,10 +1,27 @@
 // (no c types needed; kept for FFI clarity)
 use core::fmt;
 
+#[cfg(not(target_arch = "wasm32"))]
 unsafe extern "C" {
     safe fn bun_cpu_features() -> u8;
 }
 
+/// wasm has no CPUID; the only feature worth reporting is fixed at compile time.
+#[cfg(target_arch = "wasm32")]
+fn bun_cpu_features() -> u8 {
+    if cfg!(target_feature = "simd128") { Flags::SIMD128.bits() } else { 0 }
+}
+
+#[cfg(target_arch = "wasm32")]
+bitflags::bitflags! {
+    #[repr(transparent)]
+    #[derive(Copy, Clone)]
+    pub struct Flags: u8 {
+        const NONE    = 1 << 0;
+        const SIMD128 = 1 << 1;
+    }
+}
+
 #[derive(Copy, Clone)]
 pub(crate) struct CPUFeatures {
     pub flags: Flags,
@@ -44,7 +61,7 @@ bitflags::bitflags! {
     }
 }
 
-#[cfg(not(any(target_arch = "x86_64", target_arch = "aarch64")))]
+#[cfg(not(any(target_arch = "x86_64", target_arch = "aarch64", target_arch = "wasm32")))]
 compile_error!("CPUFeatures: unsupported target architecture");
 
 // Per-arch const table of flag names, skipping "none" and padding bits.
@@ -57,6 +74,9 @@ const NAMED_FLAGS: &[(&str, Flags)] = &[
     ("avx512", Flags::AVX512),
 ];
 
+#[cfg(target_arch = "wasm32")]
+const NAMED_FLAGS: &[(&str, Flags)] = &[("simd128", Flags::SIMD128)];
+
 #[cfg(target_arch = "aarch64")]
 const NAMED_FLAGS: &[(&str, Flags)] = &[
     ("neon", Flags::NEON),
