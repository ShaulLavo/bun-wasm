diff --git a/src/io/lib.rs b/src/io/lib.rs
index 545f2918..68ed490b 100644
--- a/src/io/lib.rs
+++ b/src/io/lib.rs
@@ -1963,6 +1963,39 @@ pub mod waker {
     pub type Waker = LinuxWaker;
     #[cfg(windows)]
     pub type Waker = WindowsWaker;
+    #[cfg(target_os = "wasi")]
+    pub type Waker = WasiWaker;
+
+    /// WASI: no eventfd and (on wasip1) no second thread to wake us. A wake is
+    /// a flag the next `wait` consumes; `wait` never blocks.
+    #[cfg(target_os = "wasi")]
+    pub struct WasiWaker {
+        pending: core::sync::atomic::AtomicBool,
+    }
+
+    #[cfg(target_os = "wasi")]
+    impl WasiWaker {
+        pub const fn placeholder() -> Self {
+            Self { pending: core::sync::atomic::AtomicBool::new(false) }
+        }
+
+        pub fn init() -> crate::error::Result<Self> {
+            Ok(Self::placeholder())
+        }
+
+        #[inline]
+        pub(crate) fn get_fd(&self) -> Fd {
+            Fd::INVALID
+        }
+
+        pub fn wait(&self) {
+            self.pending.store(false, core::sync::atomic::Ordering::Release);
+        }
+
+        pub fn wake(&self) {
+            self.pending.store(true, core::sync::atomic::Ordering::Release);
+        }
+    }
 
     // ── Linux / FreeBSD ───────────────────────────────────────────────────────
 
