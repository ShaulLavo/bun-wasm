+    /// `BUNWASM_FN_*` flags for a body about to be printed (see
+    /// BUNWASM_AWAIT_HOOKS). Every function body enters its own flags, sync
+    /// ones included, so a nested function never touches an outer
+    /// `__bunwasm_s`.
+    pub(crate) fn bunwasm_fn_flags(is_async: bool, is_generator: bool, stmts: &[Stmt]) -> u8 {
+        if !is_async || !bunwasm_await_hooks() || !bunwasm_has_handler(stmts) {
+            return 0;
+        }
+        if is_generator {
+            BUNWASM_FN_S | BUNWASM_FN_ASYNC_GENERATOR
+        } else {
+            BUNWASM_FN_S
+        }
+    }
+
+    /// Whether these statements (nested functions excluded) hold a `try` or a
+    /// `for await`. Iterative: else-if chains can be arbitrarily deep.
+    pub(crate) fn bunwasm_has_handler(stmts: &[Stmt]) -> bool {
+        let mut pending: Vec<Stmt> = stmts.to_vec();
+        while let Some(stmt) = pending.pop() {
+            match &stmt.data {
+                StmtData::STry(_) => return true,
+                StmtData::SForOf(s) if s.is_await => return true,
+                StmtData::SForOf(s) => pending.push(s.body),
+                StmtData::SBlock(s) => pending.extend_from_slice(slice_of(s.stmts)),
+                StmtData::SIf(s) => pending.extend([s.yes].into_iter().chain(s.no)),
+                StmtData::SFor(s) => pending.push(s.body),
+                StmtData::SForIn(s) => pending.push(s.body),
+                StmtData::SWhile(s) => pending.push(s.body),
+                StmtData::SDoWhile(s) => pending.push(s.body),
+                StmtData::SWith(s) => pending.push(s.body),
+                StmtData::SLabel(s) => pending.push(s.stmt),
+                StmtData::SSwitch(s) => {
+                    for case in slice_of(s.cases) {
+                        pending.extend_from_slice(slice_of(case.body));
+                    }
+                }
+                _ => {}
+            }
+        }
+        false
+    }
+
+    pub(crate) fn bunwasm_directive_count(stmts: &[Stmt]) -> usize {
+        stmts.iter().take_while(|s| matches!(s.data, StmtData::SDirective(_))).count()
+    }
+
+    /// The statement a chain of labels ends in.
+    pub(crate) fn bunwasm_unlabeled(mut stmt: Stmt) -> Stmt {
+        while let StmtData::SLabel(s) = &stmt.data {
+            stmt = s.stmt;
+        }
+        stmt
+    }
