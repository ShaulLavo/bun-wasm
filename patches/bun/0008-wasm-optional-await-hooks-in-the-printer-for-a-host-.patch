 // Format / GenerateSourceMap
 // ───────────────────────────────────────────────────────────────────────────
 
+/// bun-wasm: print `await`, `catch`/`finally`, async generator `yield` and
+/// `for await` with hooks, so a host JS engine without AsyncContext can carry
+/// AsyncLocalStorage across suspensions, rejected ones included. Off unless
+/// the runtime turns it on around a print (the browser engine build).
+///
+/// An async body whose own statements (nested functions excluded) hold a
+/// `try` or a `for await` is an *S body*: it declares `let __bunwasm_s = 0;`
+/// after its directives, holding the frame captured at the pending (or just
+/// rejected) suspension, and its handlers re-enter that frame:
+///
+/// - `await x` -> `__bunwasm_resumed(await __bunwasm_id(x, __bunwasm_s = __bunwasm_capture()), __bunwasm_s, __bunwasm_s = 0)`
+/// - `catch (e) {` / `finally {` -> `… { __bunwasm_caught(__bunwasm_s, __bunwasm_s = 0);`
+/// - `yield x` (async generator) -> `__bunwasm_id(yield __bunwasm_id(x, __bunwasm_s = __bunwasm_capture()), __bunwasm_s = 0)`
+/// - `for await (… of y) body` -> `{ let __bunwasm_c = __bunwasm_capture(); for await (… of __bunwasm_id(y, __bunwasm_s = __bunwasm_c)) { try { __bunwasm_resume(__bunwasm_c, __bunwasm_s = 0); body } finally { __bunwasm_s = __bunwasm_c = __bunwasm_capture(); } } __bunwasm_resume(__bunwasm_c, 0); __bunwasm_s = 0; }`
+///
+/// Every other async body keeps `__bunwasm_resume(__bunwasm_capture(), await x)`:
+/// a rejection leaves it without running more of its code. Bump
+/// `BUNWASM_HOOKS_VERSION` whenever a printed shape changes.
+pub static BUNWASM_AWAIT_HOOKS: core::sync::atomic::AtomicBool = core::sync::atomic::AtomicBool::new(false);
+
+/// Version of the shapes above; the runtime keys cached hooked text on it.
+pub const BUNWASM_HOOKS_VERSION: u32 = 2;
+
+#[inline]
+fn bunwasm_await_hooks() -> bool {
+    BUNWASM_AWAIT_HOOKS.load(core::sync::atomic::Ordering::Relaxed)
+}
+
+/// The body being printed declares `__bunwasm_s`.
+const BUNWASM_FN_S: u8 = 1;
+/// ... and is an async generator's (its `yield`s get hooks).
+const BUNWASM_FN_ASYNC_GENERATOR: u8 = 2;
+
+thread_local! {
+    /// The statement being printed is the body of a label: a `for await` there
+    /// can't be wrapped in a block (labeled `continue` needs the loop).
+    static BUNWASM_LABELED: core::cell::Cell<bool> = const { core::cell::Cell::new(false) };
+    /// `BUNWASM_FN_*` flags of the innermost function (or module top level)
+    /// being printed.
+    static BUNWASM_FN: core::cell::Cell<u8> = const { core::cell::Cell::new(0) };
+}
+
+#[inline]
+fn bunwasm_fn() -> u8 {
+    BUNWASM_FN.with(|f| f.get())
+}
+
+/// Restores the enclosing function's flags when a body is done printing.
+struct BunwasmFnScope(u8);
+
+impl Drop for BunwasmFnScope {
+    fn drop(&mut self) {
+        BUNWASM_FN.with(|f| f.set(self.0));
+    }
+}
+
+fn bunwasm_enter_fn(flags: u8) -> BunwasmFnScope {
+    BunwasmFnScope(BUNWASM_FN.with(|f| f.replace(flags)))
+}
+
