+thread_local! {
+    static BUNWASM_REGISTER: core::cell::Cell<bool> = const { core::cell::Cell::new(false) };
+    static BUNWASM_FN_DEPTH: core::cell::Cell<u32> = const { core::cell::Cell::new(0) };
+}
+
+/// bun-wasm: print an ES module's body for a registration record (the
+/// runtime's loader for engines without native ES modules, see
+/// bunwasm-transpiler's `register`): top-level `await x` as `(yield x)`, a
+/// top-level `for await` as a `yield` loop, `import.meta` as
+/// `__bunwasm_m.meta` and `import(…)` as `__bunwasm_m.import(…)`.
+pub fn with_bunwasm_register<T>(f: impl FnOnce() -> T) -> T {
+    let previous = BUNWASM_REGISTER.with(|r| r.replace(true));
+    let depth = BUNWASM_FN_DEPTH.with(|d| d.replace(0));
+    let out = f();
+    BUNWASM_REGISTER.with(|r| r.set(previous));
+    BUNWASM_FN_DEPTH.with(|d| d.set(depth));
+    out
+}
+
+#[inline]
+fn bunwasm_register() -> bool {
+    BUNWASM_REGISTER.with(|r| r.get())
+}
+
+#[inline]
+fn bunwasm_register_top_level() -> bool {
+    bunwasm_register() && BUNWASM_FN_DEPTH.with(|d| d.get()) == 0
+}
+
+/// Counts function bodies being printed, for [`bunwasm_register_top_level`].
+struct BunwasmFnDepth;
+
+impl BunwasmFnDepth {
+    fn enter() -> BunwasmFnDepth {
+        BUNWASM_FN_DEPTH.with(|d| d.set(d.get() + 1));
+        BunwasmFnDepth
+    }
+}
+
+impl Drop for BunwasmFnDepth {
+    fn drop(&mut self) {
+        BUNWASM_FN_DEPTH.with(|d| d.set(d.get() - 1));
+    }
+}
+
 /// The body being printed declares `__bunwasm_s`.
 const BUNWASM_FN_S: u8 = 1;
 /// ... and is an async generator's (its `yield`s get hooks).
