+        /// bun-wasm registration records (see `with_bunwasm_register`): a
+        /// top-level `for await` driven by `yield`. Unlabeled loops close the
+        /// iterator when left early; a labeled one must stay a bare loop.
+        fn print_bunwasm_register_for_await(&mut self, s: &S::ForOf, loc: bun_ast::Loc, labeled: bool) {
+            self.print_indent();
+            self.add_source_mapping(loc);
+            if !labeled {
+                self.print(b"{let __bunwasm_i=__bunwasm_m.ai(");
+                self.print_expr(s.value, Level::Comma, ExprFlag::none());
+                self.print(b"),__bunwasm_r;try{for(;");
+            } else {
+                self.print(b"for(let __bunwasm_i=__bunwasm_m.ai(");
+                self.print_expr(s.value, Level::Comma, ExprFlag::none());
+                self.print(b"),__bunwasm_r;");
+            }
+            self.print(b"!(__bunwasm_r=void 0,__bunwasm_r=yield __bunwasm_i.next()).done;){");
+            self.print_for_loop_init(s.init, ExprFlagSet::empty());
+            self.print(b"=__bunwasm_r.value;");
+            self.print_newline();
+            self.print_stmt(s.body).expect("unreachable");
+            self.print_indent();
+            self.print(b"}");
+            if !labeled {
+                self.print(b"}finally{if(__bunwasm_r&&!__bunwasm_r.done)yield __bunwasm_m.ac(__bunwasm_i)}}");
+            }
+            self.print_newline();
+        }
