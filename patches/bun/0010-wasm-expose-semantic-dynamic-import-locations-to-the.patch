+/// bun-wasm: collect dynamic-import keyword locations during a semantic parse.
+/// Property names, literals, and import.meta never enter parse_import_expr's
+/// dynamic-import branch. The guard restores the outer collector on unwind.
+pub fn with_bunwasm_dynamic_imports<T>(f: impl FnOnce() -> T) -> (T, Vec<usize>) {
+    struct Restore(Option<Vec<usize>>);
+    impl Drop for Restore {
+        fn drop(&mut self) {
+            BUNWASM_DYNAMIC_IMPORTS.with(|slot| { slot.replace(self.0.take()); });
+        }
+    }
+    let previous = BUNWASM_DYNAMIC_IMPORTS.with(|slot| slot.replace(Some(Vec::new())));
+    let _restore = Restore(previous);
+    let result = f();
+    let imports = BUNWASM_DYNAMIC_IMPORTS.with(|slot| slot.take().unwrap_or_default());
+    (result, imports)
+}
+
+thread_local! {
+    static BUNWASM_DYNAMIC_IMPORTS: core::cell::RefCell<Option<Vec<usize>>> = const { core::cell::RefCell::new(None) };
+}
+
+fn bunwasm_dynamic_import(loc: bun_ast::Loc) {
+    BUNWASM_DYNAMIC_IMPORTS.with_borrow_mut(|slot| {
+        if let Some(imports) = slot {
+            imports.push(loc.start as usize);
+        }
+    });
+}
