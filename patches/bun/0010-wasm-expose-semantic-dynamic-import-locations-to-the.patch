+/// bun-wasm: emitted UTF-8 ranges for the host's module linking.
+#[derive(Debug)]
+pub struct BunwasmImport {
+    pub start: usize,
+    pub end: usize,
+    pub specifier: Option<String>,
+}
+
+/// Collect from the existing print pass, after all transforms and formatting.
+pub fn with_bunwasm_imports<T>(f: impl FnOnce() -> T) -> (T, Vec<BunwasmImport>) {
+    struct Restore(Option<Vec<BunwasmImport>>);
+    impl Drop for Restore {
+        fn drop(&mut self) {
+            BUNWASM_IMPORTS.with(|slot| { slot.replace(self.0.take()); });
+        }
+    }
+    let previous = BUNWASM_IMPORTS.with(|slot| slot.replace(Some(Vec::new())));
+    let _restore = Restore(previous);
+    let result = f();
+    let imports = BUNWASM_IMPORTS.with(|slot| slot.take().unwrap_or_default());
+    (result, imports)
+}
+
+/// bun-wasm: `require(esm)` prints a single module with all imports external.
+/// Rewrite its dynamic calls directly, without scanning the bundled output.
+pub fn with_bunwasm_import_referrer<T>(from: &str, f: impl FnOnce() -> T) -> T {
+    struct Restore(Option<Vec<u8>>);
+    impl Drop for Restore {
+        fn drop(&mut self) {
+            BUNWASM_IMPORT_REFERRER.with(|slot| { slot.replace(self.0.take()); });
+        }
+    }
+    let previous = BUNWASM_IMPORT_REFERRER.with(|slot| slot.replace(Some(from.as_bytes().to_vec())));
+    let _restore = Restore(previous);
+    f()
+}
+
+thread_local! {
+    static BUNWASM_IMPORT_REFERRER: core::cell::RefCell<Option<Vec<u8>>> = const { core::cell::RefCell::new(None) };
+    static BUNWASM_IMPORTS: core::cell::RefCell<Option<Vec<BunwasmImport>>> = const { core::cell::RefCell::new(None) };
+}
+
+fn bunwasm_import(start: usize, end: usize, specifier: Option<&[u8]>) {
+    BUNWASM_IMPORTS.with_borrow_mut(|slot| {
+        if let Some(imports) = slot {
+            imports.push(BunwasmImport {
+                start,
+                end,
+                specifier: specifier.map(|s| String::from_utf8_lossy(s).into_owned()),
+            });
+        }
+    });
+}
