+/// Original-source spans from the parse pass. No AST rewriting is performed.
+#[derive(Clone, Debug)]
+pub enum BunwasmSplice {
+    Await { start: usize, operand: usize, end: usize },
+    Yield { start: usize, operand: usize, end: usize, asynchronous: bool },
+    Function { start: usize, end: usize, asynchronous: bool },
+    Prologue { start: usize, end: usize },
+    Try(usize),
+    Handler(usize),
+    Loop { start: usize, iterable: usize, iterable_end: usize, body: usize, end: usize, block: bool },
+    Label { start: usize, body: usize },
+    Eval { start: usize, indirect: bool },
+    Argument { call: usize, start: usize, end: usize, spread: bool },
+    AwaitUsing,
+}
+
+pub fn with_bunwasm_splices<T>(f: impl FnOnce() -> T) -> (T, Vec<BunwasmSplice>) {
+    struct Restore(Option<Vec<BunwasmSplice>>);
+    impl Drop for Restore {
+        fn drop(&mut self) {
+            BUNWASM_SPLICES.with(|slot| { slot.replace(self.0.take()); });
+        }
+    }
+    let previous = BUNWASM_SPLICES.with(|slot| slot.replace(Some(Vec::new())));
+    let _restore = Restore(previous);
+    let result = f();
+    let records = BUNWASM_SPLICES.with(|slot| slot.take().unwrap_or_default());
+    (result, records)
+}
+thread_local! {
+    static BUNWASM_SPLICES: core::cell::RefCell<Option<Vec<BunwasmSplice>>> = const { core::cell::RefCell::new(None) };
+}
+fn bunwasm_splice(record: BunwasmSplice) {
+    BUNWASM_SPLICES.with_borrow_mut(|slot| {
+        if let Some(records) = slot { records.push(record); }
+    });
+}
