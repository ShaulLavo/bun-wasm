new file mode 100644
index 00000000..7c8a0b66
--- /dev/null
+++ b/src/watcher/WasiWatcher.rs
@@ -0,0 +1,38 @@
+//! WASI has no file-change notifications. Watches are accepted (so `--watch`
+//! style callers keep working) but never fire; the watch thread idles.
+use core::ffi::c_int;
+
+use bun_core::ZStr;
+
+use crate::watcher_impl::Watcher;
+
+pub(crate) type Platform = WasiWatcher;
+pub(crate) type EventListIndex = c_int;
+
+#[derive(Default)]
+pub struct WasiWatcher {
+    next_index: EventListIndex,
+}
+
+impl WasiWatcher {
+    pub(crate) fn new(_root: &[u8]) -> crate::Result<Self> {
+        Ok(Self::default())
+    }
+
+    pub(crate) fn watch_path(&mut self, _pathname: &ZStr) -> bun_sys::Result<EventListIndex> {
+        self.next_index += 1;
+        Ok(self.next_index)
+    }
+
+    pub(crate) fn watch_dir(&mut self, pathname: &ZStr) -> bun_sys::Result<EventListIndex> {
+        self.watch_path(pathname)
+    }
+
+    pub(crate) fn stop(&mut self) {}
+}
+
+/// Called repeatedly by the watch thread; there is never anything to report.
+pub(crate) fn watch_loop_cycle(_this: &mut Watcher) -> bun_sys::Result<()> {
+    std::thread::sleep(std::time::Duration::from_secs(3600));
+    Ok(())
+}
