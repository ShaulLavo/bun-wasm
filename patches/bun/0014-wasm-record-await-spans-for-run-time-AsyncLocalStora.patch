+
+/// bun-wasm: `await` expressions and `for await` loops seen by a parse, as
+/// UTF-8 byte offsets, so a host engine without AsyncContext can splice its
+/// AsyncLocalStorage hooks into source it compiles at run time (eval).
+#[derive(Default, Debug)]
+pub struct BunwasmAwaitSpans {
+    /// The `await` keyword's start and the end of its operand.
+    pub awaits: Vec<(usize, usize)>,
+    pub for_awaits: Vec<BunwasmForAwait>,
+}
+
+#[derive(Debug)]
+pub struct BunwasmForAwait {
+    /// The loop's outermost label, or `for`.
+    pub start: usize,
+    pub body_start: usize,
+    pub body_end: usize,
+    pub body_is_block: bool,
+}
+
+/// Collect [`BunwasmAwaitSpans`] while `f` parses. Same guard as above.
+pub fn with_bunwasm_await_spans<T>(f: impl FnOnce() -> T) -> (T, BunwasmAwaitSpans) {
+    struct Restore(Option<BunwasmAwaitSpans>);
+    impl Drop for Restore {
+        fn drop(&mut self) {
+            BUNWASM_AWAIT_SPANS.with(|slot| { slot.replace(self.0.take()); });
+        }
+    }
+    let previous = BUNWASM_AWAIT_SPANS.with(|slot| slot.replace(Some(BunwasmAwaitSpans::default())));
+    let _restore = Restore(previous);
+    let result = f();
+    let spans = BUNWASM_AWAIT_SPANS.with(|slot| slot.take().unwrap_or_default());
+    (result, spans)
+}
+
+thread_local! {
+    static BUNWASM_AWAIT_SPANS: core::cell::RefCell<Option<BunwasmAwaitSpans>> = const { core::cell::RefCell::new(None) };
+}
+
+fn bunwasm_await(loc: bun_ast::Loc, end: usize) {
+    BUNWASM_AWAIT_SPANS.with_borrow_mut(|slot| {
+        if let Some(spans) = slot {
+            spans.awaits.push((loc.start as usize, end));
+        }
+    });
+}
+
+fn bunwasm_for_await(loc: bun_ast::Loc, body_start: bun_ast::Loc, body_is_block: bool, body_end: usize) {
+    BUNWASM_AWAIT_SPANS.with_borrow_mut(|slot| {
+        if let Some(spans) = slot {
+            spans.for_awaits.push(BunwasmForAwait {
+                start: loc.start as usize,
+                body_start: body_start.start as usize,
+                body_end,
+                body_is_block,
+            });
+        }
+    });
+}
+
+/// A label's body was the `for await` that starts at `body`: the hooks' block
+/// goes around the label, so `continue label` still names the loop.
+fn bunwasm_label_for_await(body: bun_ast::Loc, label: bun_ast::Loc) {
+    BUNWASM_AWAIT_SPANS.with_borrow_mut(|slot| {
+        let Some(last) = slot.as_mut().and_then(|spans| spans.for_awaits.last_mut()) else {
+            return;
+        };
+        if last.start == body.start as usize {
+            last.start = label.start as usize;
+        }
+    });
+}
