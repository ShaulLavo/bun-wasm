+/// bun-wasm: puts a parse collector's previous value back, also on unwind.
+struct BunwasmRestore<T: 'static> {
+    slot: &'static std::thread::LocalKey<core::cell::RefCell<Option<T>>>,
+    previous: Option<T>,
+}
+
+impl<T: 'static> Drop for BunwasmRestore<T> {
+    fn drop(&mut self) {
+        let previous = self.previous.take();
+        self.slot.with(|slot| slot.replace(previous));
+    }
+}
+
+/// Run `f` with a fresh collector in `slot`, then return what it collected.
+fn bunwasm_collect<C: Default + 'static, T>(
+    slot: &'static std::thread::LocalKey<core::cell::RefCell<Option<C>>>,
+    f: impl FnOnce() -> T,
+) -> (T, C) {
+    let previous = slot.with(|slot| slot.replace(Some(C::default())));
+    let _restore = BunwasmRestore { slot, previous };
+    let result = f();
+    let collected = slot.with(|slot| slot.take().unwrap_or_default());
+    (result, collected)
+}
+
 /// bun-wasm: collect dynamic-import keyword locations during a semantic parse.
 /// Property names, literals, and import.meta never enter parse_import_expr's
-/// dynamic-import branch. The guard restores the outer collector on unwind.
+/// dynamic-import branch.
 pub fn with_bunwasm_dynamic_imports<T>(f: impl FnOnce() -> T) -> (T, Vec<usize>) {
-    struct Restore(Option<Vec<usize>>);
-    impl Drop for Restore {
-        fn drop(&mut self) {
-            BUNWASM_DYNAMIC_IMPORTS.with(|slot| { slot.replace(self.0.take()); });
-        }
-    }
-    let previous = BUNWASM_DYNAMIC_IMPORTS.with(|slot| slot.replace(Some(Vec::new())));
-    let _restore = Restore(previous);
-    let result = f();
-    let imports = BUNWASM_DYNAMIC_IMPORTS.with(|slot| slot.take().unwrap_or_default());
-    (result, imports)
+    bunwasm_collect(&BUNWASM_DYNAMIC_IMPORTS, f)
 }
 
 thread_local! {
@@ -799,3 +814,82 @@ fn bunwasm_dynamic_import(loc: bun_ast::Loc) {
         }
     });
 }
+
+/// bun-wasm: `await` expressions, `for await` loops and direct `eval` calls
+/// seen by a parse, as UTF-8 byte offsets, so a host engine without
+/// AsyncContext can splice its AsyncLocalStorage hooks into source it
+/// compiles at run time (eval).
+#[derive(Default, Debug)]
+pub struct BunwasmAwaitSpans {
+    /// The `await` keyword's start and the end of its operand.
+    pub awaits: Vec<(usize, usize)>,
+    pub for_awaits: Vec<BunwasmForAwait>,
+    /// A direct `eval(...)` call's start, and the span between its parentheses.
+    pub evals: Vec<(usize, usize, usize)>,
+}
+
+#[derive(Debug)]
+pub struct BunwasmForAwait {
+    /// The loop's outermost label, or `for`.
+    pub start: usize,
+    pub body_start: usize,
+    pub body_end: usize,
+    pub body_is_block: bool,
+}
+
+/// Collect [`BunwasmAwaitSpans`] while `f` parses.
+pub fn with_bunwasm_await_spans<T>(f: impl FnOnce() -> T) -> (T, BunwasmAwaitSpans) {
+    bunwasm_collect(&BUNWASM_AWAIT_SPANS, f)
+}
+
+thread_local! {
+    static BUNWASM_AWAIT_SPANS: core::cell::RefCell<Option<BunwasmAwaitSpans>> = const { core::cell::RefCell::new(None) };
+}
+
+fn bunwasm_spans(record: impl FnOnce(&mut BunwasmAwaitSpans)) {
+    BUNWASM_AWAIT_SPANS.with_borrow_mut(|slot| {
+        if let Some(spans) = slot {
+            record(spans);
+        }
+    });
+}
+
+fn bunwasm_await(loc: bun_ast::Loc, end: usize) {
+    bunwasm_spans(|spans| spans.awaits.push((loc.start as usize, end)));
+}
+
+fn bunwasm_for_await(loc: bun_ast::Loc, body_start: bun_ast::Loc, body_is_block: bool, body_end: usize) {
+    bunwasm_spans(|spans| {
+        spans.for_awaits.push(BunwasmForAwait {
+            start: loc.start as usize,
+            body_start: body_start.start as usize,
+            body_end,
+            body_is_block,
+        });
+    });
+}
+
+/// A call whose target is the bare identifier `eval`: `open` and `close` are
+/// its parentheses.
+fn bunwasm_direct_eval(call: bun_ast::Loc, open: bun_ast::Loc, close: bun_ast::Loc) {
+    bunwasm_spans(|spans| {
+        spans.evals.push((call.start as usize, open.start as usize + 1, close.start as usize));
+    });
+}
+
+fn bunwasm_collecting_spans() -> bool {
+    BUNWASM_AWAIT_SPANS.with_borrow(Option::is_some)
+}
+
+/// A label's body was the `for await` that starts at `body`: the hooks' block
+/// goes around the label, so `continue label` still names the loop.
+fn bunwasm_label_for_await(body: bun_ast::Loc, label: bun_ast::Loc) {
+    bunwasm_spans(|spans| {
+        let Some(last) = spans.for_awaits.last_mut() else {
+            return;
+        };
+        if last.start == body.start as usize {
+            last.start = label.start as usize;
+        }
+    });
+}
