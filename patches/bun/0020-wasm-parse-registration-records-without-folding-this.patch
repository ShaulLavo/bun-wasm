 src/js_parser/p.rs                  |  2 +-
 src/js_parser/visit/visit_binary.rs | 31 +++++++++++---------
 src/js_parser/visit/visit_expr.rs   | 11 ++++++--
 src/js_parser/visit/visit_stmt.rs   |  4 ++-
 5 files changed, 74 insertions(+), 18 deletions(-)

diff --git a/src/js_parser/lib.rs b/src/js_parser/lib.rs
index 32222685..2bc9d006 100644
--- a/src/js_parser/lib.rs
+++ b/src/js_parser/lib.rs
@@ -790,6 +790,50 @@ pub fn with_bunwasm_dynamic_imports<T>(f: impl FnOnce() -> T) -> (T, Vec<usize>)
 
 thread_local! {
     static BUNWASM_DYNAMIC_IMPORTS: core::cell::RefCell<Option<Vec<usize>>> = const { core::cell::RefCell::new(None) };
+    static BUNWASM_REGISTER_PARSE: core::cell::Cell<bool> = const { core::cell::Cell::new(false) };
+    static BUNWASM_MODULE_NEW_TARGET: core::cell::Cell<Option<bun_ast::Loc>> = const { core::cell::Cell::new(None) };
+}
+
+/// bun-wasm: parse a module for a registration record, whose body runs as a strict
+/// generator called without a receiver. Module-level `this` stays `this` instead of
+/// becoming `null` or `exports`, `typeof` of a primitive literal is not folded, literal
+/// (in)equality is neither folded nor reordered, and an anonymous `export default
+/// function` stays anonymous, so the record keeps the module's expressions and names as
+/// written. A `new.target` outside every function is noted ([`bunwasm_module_new_target`]):
+/// it is an early error in a module but valid in CommonJS, which only the caller knows.
+/// The guard restores the outer mode on unwind.
+pub fn with_bunwasm_register_parse<T>(f: impl FnOnce() -> T) -> T {
+    struct Restore(bool, Option<bun_ast::Loc>);
+    impl Drop for Restore {
+        fn drop(&mut self) {
+            BUNWASM_REGISTER_PARSE.with(|mode| mode.set(self.0));
+            BUNWASM_MODULE_NEW_TARGET.with(|loc| loc.set(self.1));
+        }
+    }
+    let _restore = Restore(
+        BUNWASM_REGISTER_PARSE.with(|mode| mode.replace(true)),
+        BUNWASM_MODULE_NEW_TARGET.with(|loc| loc.replace(None)),
+    );
+    f()
+}
+
+/// True while parsing for a registration record (see [`with_bunwasm_register_parse`]).
+pub(crate) fn bunwasm_register_parse() -> bool {
+    BUNWASM_REGISTER_PARSE.with(|mode| mode.get())
+}
+
+/// The first `new.target` outside every function, class body and static block in the
+/// current [`with_bunwasm_register_parse`] parse.
+pub fn bunwasm_module_new_target() -> Option<bun_ast::Loc> {
+    BUNWASM_MODULE_NEW_TARGET.with(|loc| loc.get())
+}
+
+pub(crate) fn note_bunwasm_module_new_target(loc: bun_ast::Loc) {
+    BUNWASM_MODULE_NEW_TARGET.with(|first| {
+        if first.get().is_none() {
+            first.set(Some(loc));
+        }
+    });
 }
 
 fn bunwasm_dynamic_import(loc: bun_ast::Loc) {
