From 6860d25d31bb382de5c0b6132d9f8e3d76f58100 Mon Sep 17 00:00:00 2001
From: Shaul Lavochkin <shaul9191@gmail.com>
Date: Fri, 6 Nov 2026 03:35:54 +0200
Subject: [PATCH 20/20] wasm: parse registration records without folding this
 or literals

A registration record runs a module's body as a strict generator called
without a receiver. While bun-wasm parses for one
(with_bunwasm_register_parse), module-level this stays this instead of
becoming null or exports, typeof of a primitive literal and literal
(in)equality are not folded, and an anonymous export default function is
not given the generated default name. Ordinary parsing is unchanged.
---
 src/js_parser/lib.rs                | 23 +++++++++++++++++++++++
 src/js_parser/p.rs                  |  2 +-
 src/js_parser/visit/visit_binary.rs | 26 +++++++++++++-------------
 src/js_parser/visit/visit_expr.rs   |  2 +-
 src/js_parser/visit/visit_stmt.rs   |  4 +++-
 5 files changed, 41 insertions(+), 16 deletions(-)

diff --git a/src/js_parser/lib.rs b/src/js_parser/lib.rs
index 32222685..bde53420 100644
--- a/src/js_parser/lib.rs
+++ b/src/js_parser/lib.rs
@@ -790,6 +790,29 @@ pub fn with_bunwasm_dynamic_imports<T>(f: impl FnOnce() -> T) -> (T, Vec<usize>)
 
 thread_local! {
     static BUNWASM_DYNAMIC_IMPORTS: core::cell::RefCell<Option<Vec<usize>>> = const { core::cell::RefCell::new(None) };
+    static BUNWASM_REGISTER_PARSE: core::cell::Cell<bool> = const { core::cell::Cell::new(false) };
+}
+
+/// bun-wasm: parse a module for a registration record, whose body runs as a strict
+/// generator called without a receiver. Module-level `this` stays `this` instead of
+/// becoming `null` or `exports`, `typeof` of a primitive literal and literal (in)equality
+/// are not folded, and an anonymous `export default function` stays anonymous, so the
+/// record keeps the module's expressions and names as written. The guard restores the
+/// outer mode on unwind.
+pub fn with_bunwasm_register_parse<T>(f: impl FnOnce() -> T) -> T {
+    struct Restore(bool);
+    impl Drop for Restore {
+        fn drop(&mut self) {
+            BUNWASM_REGISTER_PARSE.with(|mode| mode.set(self.0));
+        }
+    }
+    let _restore = Restore(BUNWASM_REGISTER_PARSE.with(|mode| mode.replace(true)));
+    f()
+}
+
+/// True while parsing for a registration record (see [`with_bunwasm_register_parse`]).
+pub(crate) fn bunwasm_register_parse() -> bool {
+    BUNWASM_REGISTER_PARSE.with(|mode| mode.get())
 }
 
 fn bunwasm_dynamic_import(loc: bun_ast::Loc) {
