From df2acb35d9bb9c3433ce9acd180ffbf12b5d480b Mon Sep 17 00:00:00 2001
From: Shaul Lavochkin <shaul9191@gmail.com>
Date: Sat, 17 Oct 2026 08:13:07 +0300
Subject: [PATCH 11/14] wasm: make lint layout assertions pointer-width aware

---
 src/lint/rule.rs  | 2 +-
 src/sema/types.rs | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/lint/rule.rs b/src/lint/rule.rs
index 6fa28528..f4b07028 100644
--- a/src/lint/rule.rs
+++ b/src/lint/rule.rs
@@ -62,7 +62,7 @@ pub struct Message {
     pub(crate) key: u32,
 }
 
-const _: () = assert!(size_of::<Message>() == 5 * size_of::<usize>());
+const _: () = assert!(size_of::<Message>() == 4 * size_of::<usize>() + 8);
 
 impl Message {
     pub const fn new(id: &'static str, text: &'static str) -> Message {
diff --git a/src/sema/types.rs b/src/sema/types.rs
index facbbfa4..a233199c 100644
--- a/src/sema/types.rs
+++ b/src/sema/types.rs
@@ -282,7 +282,7 @@ pub enum TypeArguments<'s> {
     Deferred(ArenaBox<'s, DeferredTypeArguments>),
 }
 
-const _: () = assert!(size_of::<TypeArguments<'static>>() == 16);
+const _: () = assert!(size_of::<TypeArguments<'static>>() == 2 * size_of::<usize>());
 
 /// `TypeReference.node` and `mapper`: the type reference to a generic class or interface, the array
 /// type node or the tuple type node at `node`, in the declaration of a type alias, and the mapper
