From 25aee54f57a66aae546598a37cbdb3d6bc0370fe Mon Sep 17 00:00:00 2001
From: Shaul Lavochkin <shaul9191@gmail.com>
Date: Sat, 17 Oct 2026 08:13:07 +0300
Subject: [PATCH 11/28] wasm: make lint layout assertions pointer-width aware

---
 src/lint/rule.rs | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/lint/rule.rs b/src/lint/rule.rs
index 5871f41c..c590181d 100644
--- a/src/lint/rule.rs
+++ b/src/lint/rule.rs
@@ -61,7 +61,7 @@ pub struct Message {
     pub(crate) key: u32,
 }
 
-const _: () = assert!(size_of::<Message>() == 5 * size_of::<usize>());
+const _: () = assert!(size_of::<Message>() == 4 * size_of::<usize>() + 8);
 
 impl Message {
     pub const fn new(id: &'static str, text: &'static str) -> Message {
