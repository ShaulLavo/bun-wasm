foreach(required BUILD_DIR EXPECTED_C EXPECTED_CXX EXPECTED_SYSTEM)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "Missing cache preflight input: ${required}")
  endif()
endforeach()
if(NOT DEFINED EXPECTED_TOOLCHAIN_FILE)
  message(FATAL_ERROR "Missing cache preflight input: EXPECTED_TOOLCHAIN_FILE (empty for native defaults)")
endif()
function(refuse detail)
  message(FATAL_ERROR "CMake toolchain mismatch at ${BUILD_DIR}: ${detail}. Choose a fresh build directory; this cache was not modified.")
endfunction()

if(NOT EXISTS "${BUILD_DIR}/CMakeCache.txt")
  if(REQUIRE_CONFIGURED OR EXISTS "${BUILD_DIR}/CMakeFiles" OR EXISTS "${BUILD_DIR}/build.ninja" OR EXISTS "${BUILD_DIR}/cmake_install.cmake")
    refuse("missing CMakeCache.txt for configured build output")
  endif()
  return()
endif()
if(NOT EXISTS "${BUILD_DIR}/build.ninja")
  refuse("missing generated build.ninja")
endif()

file(READ "${BUILD_DIR}/CMakeCache.txt" cache)
foreach(part MAJOR MINOR PATCH)
  string(REGEX MATCH "CMAKE_CACHE_${part}_VERSION:INTERNAL=([0-9]+)" found "${cache}")
  if(NOT found)
    refuse("missing CMake cache version")
  endif()
  set(version_${part} "${CMAKE_MATCH_1}")
endforeach()
set(metadata "${BUILD_DIR}/CMakeFiles/${version_MAJOR}.${version_MINOR}.${version_PATCH}")

function(configured_value file key output)
  if(NOT EXISTS "${file}")
    refuse("missing compiler/target metadata ${file}")
  endif()
  file(READ "${file}" contents)
  string(REGEX MATCH "set\\(${key} \"([^\"]*)\"\\)" found "${contents}")
  if(NOT found)
    refuse("missing ${key} in ${file}")
  endif()
  set(${output} "${CMAKE_MATCH_1}" PARENT_SCOPE)
endfunction()

foreach(language C CXX)
  configured_value("${metadata}/CMake${language}Compiler.cmake" "CMAKE_${language}_COMPILER" compiler)
  if(NOT EXISTS "${compiler}" OR NOT EXISTS "${EXPECTED_${language}}")
    refuse("${language} compiler is missing")
  endif()
  file(REAL_PATH "${compiler}" configured)
  file(REAL_PATH "${EXPECTED_${language}}" expected)
  if(NOT configured STREQUAL expected)
    refuse("${language} compiler is ${configured}, requested ${expected}")
  endif()
endforeach()
configured_value("${metadata}/CMakeSystem.cmake" CMAKE_SYSTEM_NAME system)
if(EXPECTED_SYSTEM STREQUAL "native")
  set(EXPECTED_SYSTEM "${CMAKE_HOST_SYSTEM_NAME}")
endif()
if(NOT system STREQUAL EXPECTED_SYSTEM)
  refuse("system is ${system}, requested ${EXPECTED_SYSTEM}")
endif()
if(DEFINED EXPECTED_PROCESSOR AND NOT "${EXPECTED_PROCESSOR}" STREQUAL "")
  configured_value("${metadata}/CMakeSystem.cmake" CMAKE_SYSTEM_PROCESSOR processor)
  if(NOT processor STREQUAL EXPECTED_PROCESSOR)
    refuse("processor is ${processor}, requested ${EXPECTED_PROCESSOR}")
  endif()
endif()

# Compiler targets are not persisted in CMake's compiler metadata. Ninja's actual
# command rules retain them, so inspect those instead of trusting the toolchain file.
if(NOT EXISTS "${BUILD_DIR}/CMakeFiles/rules.ninja")
  refuse("missing Ninja compiler command rules")
endif()
file(READ "${BUILD_DIR}/CMakeFiles/rules.ninja" rules)
string(REGEX MATCHALL "rule (C|CXX)_COMPILER__[^\n]*\n([ \t]+[^\n]*\n)+" compiler_rules "${rules}")
if(NOT compiler_rules)
  refuse("missing C/C++ compiler command rules")
endif()
foreach(rule IN LISTS compiler_rules)
  string(REGEX MATCHALL "--target=[^ \r\n]+" targets "${rule}")
  list(REMOVE_DUPLICATES targets)
  if(DEFINED EXPECTED_TARGET AND NOT "${EXPECTED_TARGET}" STREQUAL "")
    if(NOT targets STREQUAL "--target=${EXPECTED_TARGET}")
      refuse("compiler targets are '${targets}', requested ${EXPECTED_TARGET}")
    endif()
  elseif(targets)
    refuse("compiler targets are '${targets}', requested native compiler defaults")
  endif()
endforeach()
function(validate_cached_path key expected label)
  string(REGEX MATCH "(^|\n)${key}:[^=\r\n]+=([^\r\n]*)" found "${cache}")
  set(recorded "${CMAKE_MATCH_2}")
  if("${expected}" STREQUAL "")
    if(found AND NOT "${recorded}" STREQUAL "")
      refuse("configured ${label} is ${recorded}, requested native defaults")
    endif()
    return()
  endif()
  if(NOT found OR "${recorded}" STREQUAL "")
    refuse("missing configured ${label}")
  endif()
  if(NOT EXISTS "${recorded}" OR NOT EXISTS "${expected}")
    refuse("configured or requested ${label} is missing")
  endif()
  file(REAL_PATH "${recorded}" configured)
  file(REAL_PATH "${expected}" requested)
  if(NOT configured STREQUAL requested)
    refuse("${label} is ${configured}, requested ${requested}")
  endif()
endfunction()

validate_cached_path(CMAKE_TOOLCHAIN_FILE "${EXPECTED_TOOLCHAIN_FILE}" "toolchain file")
validate_cached_path(CMAKE_SYSROOT "${EXPECTED_SYSROOT}" "sysroot")
# Per-phase settings override CMAKE_SYSROOT, including an explicitly empty value.
foreach(phase COMPILE LINK)
  string(REGEX MATCH "(^|\n)CMAKE_SYSROOT_${phase}:[^=\r\n]+=([^\r\n]*)" override "${cache}")
  if(override)
    validate_cached_path("CMAKE_SYSROOT_${phase}" "${EXPECTED_SYSROOT}" "${phase} sysroot")
  endif()
endforeach()

function(validate_toolchain_option option value)
  if(option MATCHES "target")
    if("${EXPECTED_TARGET}" STREQUAL "" OR NOT value STREQUAL EXPECTED_TARGET)
      refuse("compiler target is '${value}', requested '${EXPECTED_TARGET}'")
    endif()
    return()
  endif()
  if("${EXPECTED_SYSROOT}" STREQUAL "" OR "${value}" STREQUAL "")
    refuse("command sysroot is '${value}', requested '${EXPECTED_SYSROOT}'")
  endif()
  file(REAL_PATH "${value}" configured BASE_DIRECTORY "${BUILD_DIR}")
  file(REAL_PATH "${EXPECTED_SYSROOT}" requested)
  if(NOT EXISTS "${configured}" OR NOT EXISTS "${requested}" OR NOT configured STREQUAL requested)
    refuse("command sysroot is ${configured}, requested ${requested}")
  endif()
endfunction()

function(validate_command_options options)
  string(REPLACE "$ " " " options "${options}")
  string(REPLACE "$:" ":" options "${options}")
  string(REPLACE "$$" "$" options "${options}")
  separate_arguments(arguments UNIX_COMMAND "${options}")
  set(pending "")
  foreach(argument IN LISTS arguments)
    if(NOT pending STREQUAL "")
      validate_toolchain_option("${pending}" "${argument}")
      set(pending "")
      continue()
    endif()
    if(argument MATCHES "^(--target|-target|--sysroot|-isysroot)=(.*)$")
      validate_toolchain_option("${CMAKE_MATCH_1}" "${CMAKE_MATCH_2}")
    elseif(argument MATCHES "^(--target|-target|--sysroot|-isysroot)$")
      set(pending "${argument}")
    elseif(argument MATCHES "^-isysroot(.+)$")
      validate_toolchain_option("-isysroot" "${CMAKE_MATCH_1}")
    endif()
  endforeach()
  if(NOT pending STREQUAL "")
    refuse("missing command value for ${pending}")
  endif()
endfunction()

# CMake resolves configuration and target properties into Ninja edge bindings.
# They follow the rule prefix and can override it, including through response files.
# Inspect generated bindings directly: even `ninja -t commands` would launch Ninja.
file(GLOB manifests "${BUILD_DIR}/*.ninja" "${BUILD_DIR}/CMakeFiles/*.ninja")
foreach(manifest IN LISTS manifests)
  file(STRINGS "${manifest}" bindings REGEX "^  (FLAGS|LINK_FLAGS|LANGUAGE_COMPILE_FLAGS) = ")
  list(REMOVE_DUPLICATES bindings)
  foreach(binding IN LISTS bindings)
    string(REGEX REPLACE "^  [A-Z_]+ = " "" options "${binding}")
    validate_command_options("${options}")
  endforeach()
endforeach()
string(REGEX MATCHALL "rule (C|CXX)_(COMPILER__|[^\n]*LINKER__)[^\n]*\n([ \t]+[^\n]*\n)+" command_rules "${rules}")
foreach(rule IN LISTS command_rules)
  string(REGEX MATCH "  command = ([^\n]*)" command "${rule}")
  validate_command_options("${CMAKE_MATCH_1}")
endforeach()
