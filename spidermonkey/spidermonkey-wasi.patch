+template <size_t Bytes, typename Call>
+MOZ_NEVER_INLINE auto CallWithWasmStackReservation(Call&& call) {
+  alignas(16) unsigned char reservation[Bytes];
+  asm volatile("" : : "r"(reservation) : "memory");
+  auto result = call();
+  asm volatile("" : : "r"(reservation) : "memory");
+  return result;
