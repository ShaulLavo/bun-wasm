+// [call, target, this, a1...] becomes [target, this, a1...]: one argument
+// fewer, so the caller's cleanup still lands on the builtin's slot. With no
+// arguments, |this| is undefined.
+static void RewriteLoopCall(InterpreterRegs& regs, CallArgs& args,
+                            JSFunction* target) {
+  Value* operands = args.base();
+  unsigned argc = args.length();
+  bool ignoresReturnValue = args.ignoresReturnValue();
+  operands[0].setObject(*target);
+  if (argc == 0) {
+    operands[1].setUndefined();
+    args = CallArgsFromSp(0, regs.sp, NO_CONSTRUCT, ignoresReturnValue);
+    return;
+  }
+  for (unsigned i = 1; i <= argc; i++) {
+    operands[i] = operands[i + 1];
+  }
+  regs.sp--;
+  args = CallArgsFromSp(argc - 1, regs.sp, NO_CONSTRUCT, ignoresReturnValue);
+}
+
+// apply with no list, null or undefined: zero arguments, |this| from the first
+// argument, and every later operand dropped. The caller's cleanup still lands
+// on the builtin's slot.
+static void RewriteLoopApplyWithoutList(InterpreterRegs& regs, CallArgs& args,
+                                        JSFunction* target) {
+  Value* operands = args.base();
+  bool ignoresReturnValue = args.ignoresReturnValue();
+  operands[1] = args.get(0);
+  operands[0].setObject(*target);
+  regs.sp = operands + 2;
+  args = CallArgsFromSp(0, regs.sp, NO_CONSTRUCT, ignoresReturnValue);
+}
+
+// Runs Function.prototype.call and apply to a scripted target as a frame of
+// this loop. |args| belongs to a call opcode, never a construction. Every
+// condition that keeps the native route is checked before anything changes;
+// after the operands are rewritten a failure is an error, never a fallback.
+// Out of line, like PushDeferredGetterFrame.
+static MOZ_NEVER_INLINE LoopCall PrepareLoopCall(
+    JSContext* cx, InterpreterActivation& activation, CallArgs& args) {
+  JSFunction* builtin = &args.callee().as<JSFunction>();
+  bool apply = builtin->native() == fun_apply;
+  MOZ_ASSERT(apply || builtin->native() == fun_call);
