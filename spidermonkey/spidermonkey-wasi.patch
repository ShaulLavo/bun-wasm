+  sp = fp_->prevsp() - (StackUses(JSOp(*pc), pc) - 1);
+  fp_ = fp_->prev();
+  MOZ_ASSERT(fp_);
+}
+
+void InterpreterStack::popOwnedInlineFrame(InterpreterRegs& regs) {
+  InterpreterFrame* fp = regs.fp();
+  regs.popOwnedInlineFrame();
+  if (!fp->discardsReturnValue()) {
+    regs.sp[-1] = fp->returnValue();
+  }
+  releaseFrame(fp);
+  MOZ_ASSERT(regs.fp());
+}
