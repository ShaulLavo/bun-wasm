+#  if defined(BUNWASM_EMBED)
+// The parser and bytecode emitter spend far less host stack per depth unit
+// than runtime reentry, so they get their own bound on the shared counter,
+// sized from Chromium's worker stack, the smallest measured browser host.
+// A runtime unit held when the compile began can cost four frontend units of
+// host stack, so each one beyond an ordinary entry depth removes three units
+// of the bound, which never drops below the runtime limit.
+static constexpr uint32_t BunwasmFrontendDepthLimit = 1300u;
+static constexpr uint32_t BunwasmFrontendFreeEntryDepth = 32u;
+static constexpr uint32_t BunwasmFrontendEntryDepthWeight = 3u;
+
+static uint32_t BunwasmFrontendLimit(uint32_t entryDepth) {
+  constexpr uint32_t runtimeLimit = JS::RootingContext::wasiRecursionDepthLimit;
+  constexpr uint32_t room = BunwasmFrontendDepthLimit - runtimeLimit;
+  uint32_t excess = entryDepth > BunwasmFrontendFreeEntryDepth
+                        ? entryDepth - BunwasmFrontendFreeEntryDepth
+                        : 0;
+  if (excess >= room / BunwasmFrontendEntryDepthWeight) {
+    return runtimeLimit;
+  }
+  return BunwasmFrontendDepthLimit - BunwasmFrontendEntryDepthWeight * excess;
+}
+#  endif
