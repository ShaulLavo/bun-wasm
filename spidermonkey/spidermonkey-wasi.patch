+// Delazifies a deferred getter and publishes its owned-arguments frame. The
+// getter stays in the interpreter's mutable function root and the receiver in
+// the case's rooted copy until the frame holds both. Out of line, so that
+// js::Interpret's own frame, which every remaining native reentry pays for,
+// does not grow.
+static MOZ_NEVER_INLINE bool PushDeferredGetterFrame(
+    JSContext* cx, InterpreterActivation& activation, HandleFunction getter,
+    HandleValue receiver) {
