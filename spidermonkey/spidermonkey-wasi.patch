+// ObjectOperations-inl.h's inline GetProperty(obj, receiver, name), except that
+// a native object's eligible scripted getter is returned instead of called.
+// Exotic objects keep the ordinary synchronous route. Inline like the original,
+// so the lookup adds no native frame.
+static MOZ_ALWAYS_INLINE bool GetPropertyDeferredFrom(
+    JSContext* cx, HandleObject obj, HandleValue receiver,
+    Handle<PropertyName*> name, MutableHandleValue vp,
+    MutableHandleFunction getter) {
+  RootedId id(cx, NameToId(name));
