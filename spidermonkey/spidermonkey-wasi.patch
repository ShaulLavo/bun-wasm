+      cx->realm()->debuggerObservesNativeCall() || !args.thisv().isObject() ||
+      !args.thisv().toObject().is<JSFunction>()) {
+    return LoopCall::Native;
+  }
+  JSFunction* target = &args.thisv().toObject().as<JSFunction>();
+  if (!target->isInterpreted() || target->isClassConstructor()) {
+    return LoopCall::Native;
