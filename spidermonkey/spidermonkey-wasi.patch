+static bool IsLoopApplyList(JSObject* list, uint32_t* length) {
+  if (list->is<ArrayObject>()) {
+    if (!IsPackedArray(list)) {
+      return false;
+    }
+    *length = list->as<ArrayObject>().length();
+    return *length <= ARGS_LENGTH_MAX;
+  }
+  if (!list->is<ArgumentsObject>()) {
+    return false;
+  }
+  // Upstream's optimised apply route (CacheIR's FunApplyArgsObj) uses the same
+  // guards: with none of these set, the length and elements are exactly the
+  // call's original arguments and reading them runs no script.
+  ArgumentsObject& arguments = list->as<ArgumentsObject>();
+  if (arguments.hasOverriddenLength() || arguments.hasOverriddenElement() ||
+      arguments.anyArgIsForwarded()) {
+    return false;
+  }
+  *length = arguments.initialLength();
+  return true;
