+#if defined(__wasi__) && defined(BUNWASM_EMBED)
+MOZ_ALWAYS_INLINE bool InterpreterStack::pushInlineGetterFrame(
+    JSContext* cx, InterpreterRegs& regs, HandleFunction callee,
+    HandleScript script, HandleValue receiver) {
+  MOZ_ASSERT(regs.fp());
+  MOZ_ASSERT(callee->baseScript() == script);
+  LifoAlloc::Mark mark = allocator_.mark();
+  unsigned nformal = callee->nargs();
+  unsigned nvals = 2 + nformal + script->nslots();
+  uint8_t* buffer =
+      allocateFrame(cx, sizeof(InterpreterFrame) + nvals * sizeof(Value));
+  if (!buffer) {
+    return false;
+  }
