+// this many recursion units are held (the backstop where the quota is the
+// whole shadow stack). StackIsDeep below reports it.
+inline constexpr size_t DeepStackQuotaNumerator = 1;
+inline constexpr size_t DeepStackQuotaDenominator = 4;
+inline constexpr size_t DeepStackUnits = 128;
+// Native reentry into scripts (call/apply, getters, setters, bound and proxy
+// targets). A program's own entry chain stays shallow and pays the tier's
+// size; PBL enters through its trampoline and a much larger frame. Runaway
+// recursion goes deep, where the large size makes the quota fire before the
+// host stack runs out on either tier.
+inline constexpr size_t RunScriptReserve = 1840;
+inline constexpr size_t RunScriptPBLReserve = 2304;
+inline constexpr size_t RunScriptDeepReserve = 4096;
+// Portable baseline inline caches calling a scripted getter, setter or callee.
+inline constexpr size_t PBLCallReserve = 384;
