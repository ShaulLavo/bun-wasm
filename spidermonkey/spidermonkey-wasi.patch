+// stays on its recursion cycle after the parser frame merges. Every cycle
+// the measurement probe nests holds one; a cycle it does not nest may hold
+// none. A statement level holds statementList's (through
+// statementListItem) and its own function's: ifStatement's, tryStatement's,
+// or statement's when it is a body or a label's target. An expression level
+// holds assignExpr's, unaryExpr's and memberExpr's; chains that pass only
+// one of them (assignments, conditionals, unary operators, `new`) hold that
+// one.
+inline constexpr size_t StatementListItemReserve = 640;
+inline constexpr size_t IfStatementReserve = 256;
+inline constexpr size_t TryStatementReserve = 288;
+inline constexpr size_t StatementReserve = 1104;
+inline constexpr size_t AssignExprReserve = 880;
+inline constexpr size_t UnaryExprReserve = 592;
+inline constexpr size_t MemberExprReserve = 848;
+// Levels that add a frame of their own to those three.
+inline constexpr size_t ArgumentListReserve = 464;
+inline constexpr size_t TemplateLiteralReserve = 512;
+inline constexpr size_t FunctionBodyReserve = 1696;
