+  if (!script) {
+    return LoopCall::Error;
+  }
+  // Delazification may GC: the list and |this| are reread from the traced
+  // operands. No script ran, so the list is still eligible.
+  RootedValue thisv(cx, args[0]);
+  JSObject* list = &args[1].toObject();
+  MOZ_ASSERT(IsLoopApplyList(list, &length));
+  auto fill = [list, length](Value* argv) {
+    CopyLoopApplyList(list, length, argv);
+  };
+  if (!activation.pushOwnedInlineFrame(fun, script, thisv, length, fill)) {
+    return LoopCall::Error;
+  }
+  return LoopCall::Owned;
+}
