+  InterpreterFrame* fp = reinterpret_cast<InterpreterFrame*>(argv + nformal);
+  fp->mark_ = mark;
+  fp->initCallFrame(regs.fp(), regs.pc, regs.sp, *callee, script, argv, 0,
+                    NO_CONSTRUCT);
+  fp->setOwnedArguments(InterpreterFrame::InlineReturnMode::ReplaceValue);
+  regs.prepareToRun(*fp, script);
