+JS_PUBLIC_API JS::ModuleEvaluationInfo JS::GetModuleEvaluationInfo(
+    JSObject* moduleObj) {
+  AssertHeapIsIdle();
+  const auto& module = moduleObj->as<ModuleObject>();
+  if (!module.hasCyclicModuleFields()) {
+    return {ModuleEvaluationState::Fulfilled, false, false};
+  }
+
+  const bool entered = module.bodyEntered();
+  if (module.hadEvaluationError()) {
+    const Value error = module.evaluationError();
+    const JSErrorReport* report =
+        error.isObject() && error.toObject().is<ErrorObject>()
+            ? error.toObject().as<ErrorObject>().getErrorReport()
+            : nullptr;
+    return {ModuleEvaluationState::Failed, entered,
+            report && report->errorNumber == JSMSG_OVER_RECURSED};
+  }
+
+  switch (module.status()) {
+    case ModuleStatus::New:
+    case ModuleStatus::Unlinked:
+    case ModuleStatus::Linking:
+    case ModuleStatus::Linked:
+      return {ModuleEvaluationState::Unevaluated, entered, false};
+    case ModuleStatus::Evaluating:
+    case ModuleStatus::EvaluatingAsync:
+      return {ModuleEvaluationState::Pending, entered, false};
+    case ModuleStatus::Evaluated:
+      return {ModuleEvaluationState::Fulfilled, entered, false};
+    case ModuleStatus::Evaluated_Error:
