+  // Lists that need script or a lookup to read (array-likes, holes, proxies,
+  // over-limit lengths, non-objects with their TypeError) stay native, so
+  // upstream's order of checks and errors is untouched. An owned frame skips
+  // the inline call path's realm entry, so the target must share this realm.
+  uint32_t length;
+  if (!args[1].isObject() || target->realm() != cx->realm() ||
+      !IsLoopApplyList(&args[1].toObject(), &length)) {
+    return LoopCall::Native;
+  }
