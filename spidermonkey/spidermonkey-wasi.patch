   if (maybeCx_) {
+#  if defined(BUNWASM_EMBED)
+    return JS::RootingContext::get(maybeCx_)->wasiRecursionDepth <
+           BunwasmFrontendLimit(wasiEntryDepth_);
+#  else
     return CheckWasiRecursionLimit(maybeCx_);
+#  endif
   }
   return true;
 }
