+  if (args.length() < 2 || args[1].isNullOrUndefined()) {
+#  ifdef BUNWASM_INTERPRETER_CONTROLS
+    bunsm_test_loop_call(cx, false);
+#  endif
+    RewriteLoopApplyWithoutList(regs, args, target);
+    return LoopCall::Inline;
+  }
