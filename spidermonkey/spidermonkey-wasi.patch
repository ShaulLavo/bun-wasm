+ * Which capture-time branch produced a SavedFrame's source string.
+ * Cloned and reconstructed frames have no provenance and report DisplayURL,
+ * meaning the label is opaque and must stay raw.
+ */
+enum class SavedFrameSourceKind : uint8_t {
+  // The script source's displayURL, or an opaque cloned/reconstructed label.
+  DisplayURL,
+  // The script's compiler filename, including introduced eval, Function and
+  // WebAssembly names derived from it.
+  Filename
+};
+
+/** Capture-time category, independent of the nullable function display name. */
+enum class SavedFrameKind : uint8_t {
+  Unknown = 0,  // Reconstructed frames without authoritative capture metadata.
+  Program = 1,  // Non-function script, module or eval body.
+  Function = 2,  // JavaScript function, including nameless functions.
+  Wasm = 3
+};
