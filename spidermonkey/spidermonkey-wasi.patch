+// bun-wasm: the host call stack of a wasm module is invisible to it, so the
+// byte quota (JS_SetNativeStackQuota) only measures the shadow stack in linear
+// memory. Recursive paths whose host frames hold few shadow bytes reserve
+// extra shadow bytes per level, sized from the host stack one level uses, so
+// the quota fires before the host stack runs out. A reservation lasts until
+// the reserving frame returns. docs/bun-patches/spidermonkey-stack-budget.md
+// keeps the measurements behind each size.
+#if defined(__wasi__) && defined(BUNWASM_EMBED)
+#  define BUNWASM_RESERVE_STACK(bytes) \
+    alignas(16) unsigned char bunwasmShadowFrame[bytes]; \
+    asm volatile("" : : "r"(bunwasmShadowFrame) : "memory")
+#  define BUNWASM_RESERVED_CALL(bytes, ...) \
+    ::js::CallWithWasmStackReservation<bytes>([&] { return __VA_ARGS__; })
+// A size chosen at run time, such as by tier. Released when the frame returns.
+#  define BUNWASM_RESERVE_STACK_DYNAMIC(bytes)                 \
+    void* bunwasmShadowFrame = __builtin_alloca(bytes);        \
+    asm volatile("" : : "r"(bunwasmShadowFrame) : "memory")
+#else
+#  define BUNWASM_RESERVE_STACK(bytes) ((void)0)
+#  define BUNWASM_RESERVED_CALL(bytes, ...) (__VA_ARGS__)
+#  define BUNWASM_RESERVE_STACK_DYNAMIC(bytes) ((void)0)
+#endif
