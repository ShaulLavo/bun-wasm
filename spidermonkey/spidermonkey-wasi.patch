+// Copies an eligible apply list (IsLoopApplyList) into a frame's arguments.
+// Neither kind of read can run script or GC.
+static void CopyLoopApplyList(JSObject* list, uint32_t length, Value* argv) {
+  if (list->is<ArgumentsObject>()) {
+    MOZ_ALWAYS_TRUE(
+        list->as<ArgumentsObject>().maybeGetElements(0, length, argv));
+    return;
+  }
+  ArrayObject& array = list->as<ArrayObject>();
+  for (uint32_t i = 0; i < length; i++) {
+    argv[i] = array.getDenseElement(i);
+  }
