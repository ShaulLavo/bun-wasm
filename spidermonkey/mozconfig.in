# Generated by the bun-wasm SpiderMonkey build lane.
mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/../obj

ac_add_options --enable-project=js
ac_add_options --disable-js-shell
ac_add_options --target=wasm32-wasip1
ac_add_options --without-intl-api
ac_add_options --without-system-zlib
ac_add_options --disable-jit
ac_add_options --disable-shared-js
ac_add_options --disable-shared-memory
ac_add_options --disable-tests
ac_add_options --disable-clang-plugin
ac_add_options --disable-debug-symbols
ac_add_options --disable-stdcxx-compat
ac_add_options --enable-optimize=-O2
ac_add_options --disable-debug
ac_add_options --enable-portable-baseline-interp
ac_add_options --with-sysroot=$BUN_WASM_SYSROOT
ac_add_options --disable-bootstrap

export CC="$WASI_SDK_PATH/bin/clang"
export CXX="$WASI_SDK_PATH/bin/clang++"
export HOST_CC="/usr/bin/clang"
export HOST_CXX="/usr/bin/clang++"
export CFLAGS="-fPIC -fno-exceptions -D_WASI_EMULATED_PROCESS_CLOCKS -D_WASI_EMULATED_GETPID"
export CXXFLAGS="-fPIC -fno-exceptions -D_WASI_EMULATED_PROCESS_CLOCKS -D_WASI_EMULATED_GETPID"
export RUSTC="$(command -v rustc)"
export CARGO="$(command -v cargo)"
export CBINDGEN="$CARGO_HOME/bin/cbindgen"
